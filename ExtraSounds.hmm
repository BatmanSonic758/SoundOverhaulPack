Code "Unique Super Sonic Boost Sound (Secondary)" by "Batman Sonic & SuperNova124"
//Restores Super Sonic's unique boost sound that he used to have.

#import "GOComponents"
#import "PlayerVisuals"

#include "Reflection" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conSuperSonicBoostSecondary = 0;
static string soundFileName = "";
static string superSonic2SoundFileName = ""; // New variable for SuperSonic2 sound
static bool wasSuperSonic2 = false; // Track previous state

bool isBoost = IS_STATE_FLAG(IsBoost);

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conSuperSonicBoostSecondary = INI.Parse<int>(ini["Main"]["SuperSonicBoostSecondary"], conSuperSonicBoostSecondary);

        // Change the sound file based on conSuperSonicBoostSecondary
        switch (conSuperSonicBoostSecondary)
        {
            case 1:
                soundFileName = "SFX_SuperSonicSecondary.wav";
                superSonic2SoundFileName = "SFX_SuperSonicSecondarySS2.wav";
                break;
            case 2:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["superboostsecondaryVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

List<Sonic.StateID> SuperStates = new()
{
    Sonic.StateID.StateFly,
    Sonic.StateID.StateFlyLocal,
    Sonic.StateID.StateFlyLocal2D,
    Sonic.StateID.StateFlyOnPath,
    Sonic.StateID.StateFlyTurn,
    Sonic.StateID.StateAvoid
};

bool isSuper = SuperStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

var data = Player.GetPlayerData();
if (data == null)
    return;

var gocVisual = GameObject.GetGOC<GOCPlayerVisual>(&data->GameObject);
if (gocVisual == null)
    return;

var visual = gocVisual->GetVisual<VisualSuperSonic>();
if (visual == null)
    return;

if (conSuperSonicBoostSecondary == 2)
{
    // Disable sounds
}
else if (isSuper && isBoost)
{
    bool isCurrentlySuperSonic2 = visual->IsSuperSonic2;

    if (Lua.GetState() != 0 && (!soundPlayed || wasSuperSonic2 != isCurrentlySuperSonic2))
    {
        string soundPath;

        if (isCurrentlySuperSonic2)
        {
            soundPath = Path.Combine(currentModDirectory, "raw_customSuper", superSonic2SoundFileName);
        }
        else
        {
            soundPath = Path.Combine(currentModDirectory, "raw_customSuper", soundFileName);
        }

        if (File.Exists(soundPath))
        {
            sound.Open(new Uri(soundPath));
            sound.Volume = volumeLevel / 100;
            sound.Position = new TimeSpan(0);
            sound.Play();
            soundPlayed = true;
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
        }

        wasSuperSonic2 = isCurrentlySuperSonic2;
    }

    if (isPaused && Lua.GetState() != 0)
    {
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed && !isBoost)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Restore Boost Jet" by "Batman Sonic & SuperNova124"
//Restore Boost Jet by Batman Sonic & SuperNova124

#include "Reflection" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conBoostJet = 0;
static int conBoostJetSound = 0;
static string soundFileName = "";

bool isBoost = IS_STATE_FLAG(IsBoost);
bool isPowerBoost = IS_WORLD_FLAG(IsPowerBoost);
bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
bool isSuperSonic = BlackboardStatus.IsSuper()

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conBoostJet = INI.Parse<int>(ini["Main"]["BoostJet"], conBoostJet);
		conBoostJetSound = INI.Parse<int>(ini["Main"]["BoostJetSound"], conBoostJetSound);

        // Change the sound file based on conBoostJet
        switch (conBoostJetSound)
        {
            case 1:
                soundFileName = "SFX_BoostImpact.wav";
                break;
            case 2:
                soundFileName = "SFX_BoostImpactFrontiers.wav";
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["boostjetVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

if (conBoostJet == 4)
{
    // Disable sounds
}
else if (conBoostJet == 1)
{
    if (isBoost)
    {
        if (Lua.GetState() != 0 && !soundPlayed)
        {
            string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

            if (File.Exists(boostSoundPath))
            {
                sound.Open(new Uri(boostSoundPath));
                sound.Volume = volumeLevel / 100;
                sound.Position = new TimeSpan(0);
                sound.Play();
                soundPlayed = true;
            }
            else
            {
                Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
            }
        }

        if (isPaused && Lua.GetState() != 0)
        {
            sound.Play();
            isPaused = false;
        }
    }
    else
    {
        if (soundPlayed && !isBoost)
        {
            sound.Stop();
            soundPlayed = false;
        }
    }
}
else if (conBoostJet == 2)
{
    if ((isBoost && isPowerBoost) || (isBoost && isCyberSpace && !isPowerBoost) || (isBoost && isSuperSonic && !isPowerBoost))
    {
        if (Lua.GetState() != 0 && !soundPlayed)
        {
            string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

            if (File.Exists(boostSoundPath))
            {
                sound.Open(new Uri(boostSoundPath));
                sound.Volume = volumeLevel / 100;
                sound.Position = new TimeSpan(0);
                sound.Play();
                soundPlayed = true;
            }
            else
            {
                Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
            }
        }

        if (isPaused && Lua.GetState() != 0)
        {
            sound.Play();
            isPaused = false;
        }
    }
    else
    {
        if (soundPlayed && (!isBoost || (!isPowerBoost && !isCyberSpace && !isSuperSonic)))
        {
            sound.Stop();
            soundPlayed = false;
        }
    }
}
else if (conBoostJet == 3)
{
    if (isBoost && isCyberSpace)
    {
        if (Lua.GetState() != 0 && !soundPlayed)
        {
            string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

            if (File.Exists(boostSoundPath))
            {
                sound.Open(new Uri(boostSoundPath));
                sound.Volume = volumeLevel / 100;
                sound.Position = new TimeSpan(0);
                sound.Play();
                soundPlayed = true;
            }
            else
            {
                Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
            }
        }

        if (isPaused && Lua.GetState() != 0)
        {
            sound.Play();
            isPaused = false;
        }
    }
    else
    {
        if (soundPlayed && (!isBoost || !isCyberSpace))
        {
            sound.Stop();
            soundPlayed = false;
        }
    }
}
else
{
    // Handle other cases if needed
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Restore Boost Jet (Drift Hotfix)" by "Batman Sonic & SuperNova124"
// Restore Boost Jet by Batman Sonic & SuperNova124

#include "Reflection" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conBoostJet = 0;
static int conBoostJetSound = 0;
static int conSonicDriftBoost = 0;
static string soundFileName = "";

bool isBoost = IS_STATE_FLAG(IsBoost);
bool isPowerBoost = IS_WORLD_FLAG(IsPowerBoost);
bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
bool isSuperSonic = BlackboardStatus.IsSuper();

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conBoostJet = INI.Parse<int>(ini["Main"]["BoostJet"], conBoostJet);
		conBoostJetSound = INI.Parse<int>(ini["Main"]["BoostJetSound"], conBoostJetSound);
        conSonicDriftBoost = INI.Parse<int>(ini["Main"]["SonicDriftBoost"], conSonicDriftBoost);

        // Change the sound file based on conBoostJet
        switch (conBoostJetSound)
        {
            case 1:
                soundFileName = "SFX_BoostImpact.wav";
                break;
            case 2:
                soundFileName = "SFX_BoostImpactFrontiers.wav";
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["boostjetVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

if (conSonicDriftBoost == 1)
{
    if (conBoostJet == 1)
    {
        // Option 1 behavior
        if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsPressed(Player.InputActionType.PlayerBoost))
        {
            if (Lua.GetState() != 0 && !soundPlayed)
            {
                string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

                if (File.Exists(boostSoundPath))
                {
                    sound.Open(new Uri(boostSoundPath));
                    sound.Volume = volumeLevel / 100;
                    sound.Position = new TimeSpan(0);
                    sound.Play();
                    soundPlayed = true;
                }
                else
                {
                    Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
                }
            }

            if (isPaused && Lua.GetState() != 0)
            {
                sound.Play();
                isPaused = false;
            }
        }
        else
        {
            if (soundPlayed && !Player.Input.IsDown(Player.InputActionType.PlayerBoost))
            {
                sound.Stop();
                soundPlayed = false;
            }
        }
    }
    else if (conBoostJet == 2)
    {
        // Option 2 behavior
        if ((Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsPressed(Player.InputActionType.PlayerBoost) && isPowerBoost) || (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsPressed(Player.InputActionType.PlayerBoost) && isCyberSpace && !isPowerBoost) || (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsPressed(Player.InputActionType.PlayerBoost) && isSuperSonic && !isPowerBoost))
        {
            if (Lua.GetState() != 0 && !soundPlayed)
            {
                string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

                if (File.Exists(boostSoundPath))
                {
                    sound.Open(new Uri(boostSoundPath));
                    sound.Volume = volumeLevel / 100;
                    sound.Position = new TimeSpan(0);
                    sound.Play();
                    soundPlayed = true;
                }
                else
                {
                    Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
                }
            }

            if (isPaused && Lua.GetState() != 0)
            {
                sound.Play();
                isPaused = false;
            }
        }
        else
        {
            if (soundPlayed && (!Player.Input.IsDown(Player.InputActionType.PlayerBoost) || (!isPowerBoost && !isCyberSpace && !isSuperSonic)))
            {
                sound.Stop();
                soundPlayed = false;
            }
        }
    }
    else if (conBoostJet == 3)
    {
        // Option 3 behavior
        if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsPressed(Player.InputActionType.PlayerBoost) && isCyberSpace)
        {
            if (Lua.GetState() != 0 && !soundPlayed)
            {
                string boostSoundPath = Path.Combine(currentModDirectory, "raw_customAction", soundFileName);

                if (File.Exists(boostSoundPath))
                {
                    sound.Open(new Uri(boostSoundPath));
                    sound.Volume = volumeLevel / 100;
                    sound.Position = new TimeSpan(0);
                    sound.Play();
                    soundPlayed = true;
                }
                else
                {
                    Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
                }
            }

            if (isPaused && Lua.GetState() != 0)
            {
                sound.Play();
                isPaused = false;
            }
        }
        else
        {
            if (soundPlayed && (!Player.Input.IsDown(Player.InputActionType.PlayerBoost) || !isCyberSpace))
            {
                sound.Stop();
                soundPlayed = false;
            }
        }
    }
    else
    {
        // Handle other cases if needed
    }
}
else if (conSonicDriftBoost == 2 && conBoostJet == 4)
{
    // Option 4 behavior
    if (soundPlayed && (!Player.Input.IsDown(Player.InputActionType.PlayerBoost)))
    {
        sound.Stop();
        soundPlayed = false;
    }
}
else
{
    // Handle other cases if needed
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Dreamcast-styled Light Dash" by "Batman Sonic & SuperNova124"
//Adds the Light Dash impact from both Adventure titles

#include "Reflection" noemit

#lib "Player"
