Code "Flying Sound in Stomping" by "Batman Sonic"
//

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Tails"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#import "States"
	
#load "System.Numerics.dll"

using System.Numerics;

static bool isTailSpin = false;
static int soundTailSpin = -1; // Use a variable to keep track of the sound instance

{
    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    // Assuming Player.State has a method like GetCurrentStateID
    if (Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.TailsStateStompingDown)
    {
        if (!isTailSpin)
        {
            soundTailSpin = Player.Sound.PlaySound("ta_fly_loop");
            isTailSpin = true;
        }
    }
    else if (Player.State.GetCurrentStateID<Tails.StateID>() != Tails.StateID.TailsStateStompingDown)
    {
        if (isTailSpin)
        {
            // Use a fixed statement to get the address of soundTailSpin
            fixed (int* ptrSoundTailSpin = &soundTailSpin)
            {
                Player.Sound.StopSound(ptrSoundTailSpin);
            }
            isTailSpin = false;
        }
    }
}

Code "Spin Dash Boost Sound Fix for Tails and Amy" by "Batman Sonic & SuperNova124"
//Fixes Tails and Amy's boost sounds being missing during a Spin Dash.

#include "Reflection" noemit

#lib "Player"
#lib "Tails"
#lib "Amy"

#load "System.Numerics.dll"

using System.Numerics;

static bool isBoostFixTails = false;
static bool isBoostFixAmy = false;

bool isBoost = IS_STATE_FLAG(IsBoost);

{
    if (Player.GetPlayerType() == Player.PlayerType.Tails)
    {
        if ((Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.StateSpinBoost) &&
            Player.State.GetPreviousStateID<Tails.StateID>() != Tails.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isBoostFixTails)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isBoostFixTails = true;
            }
        }
        else
        {
            isBoostFixTails = false;
        }

        if ((Player.State.GetCurrentStateID<Tails.StateID>() != Tails.StateID.StateSpinBoost) &&
            Player.State.GetPreviousStateID<Tails.StateID>() == Tails.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            {
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
    else if (Player.GetPlayerType() == Player.PlayerType.Amy)
    {
        if ((Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateSpinBoost) &&
            Player.State.GetPreviousStateID<Amy.StateID>() != Amy.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isBoostFixAmy)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isBoostFixAmy = true;
            }
        }
        else
        {
            isBoostFixAmy = false;
        }

        if ((Player.State.GetCurrentStateID<Amy.StateID>() != Amy.StateID.StateSpinBoost) &&
            Player.State.GetPreviousStateID<Amy.StateID>() == Amy.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            {
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
}

Code "Max Ring Grind Boost Sound Fix for Tails and Amy" by "Batman Sonic & SuperNova124"
//Fixes Tails and Amy's boost sounds being missing when boosting on rails with max rings.

#include "Reflection" noemit

#lib "Player"
#lib "Tails"
#lib "Amy"
#lib "BlackboardItem"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;

static bool isBoostFixTails = false;
static bool isBoostFixAmy = false;

bool isBoost = IS_STATE_FLAG(IsBoost);

{
    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    int maxrings = pBlackboardItem->RingCapacity;
    int rings = pBlackboardItem->RingCount;

    if (Player.GetPlayerType() == Player.PlayerType.Tails)
    {
        if ((Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.StateGrind) &&
            Player.State.GetPreviousStateID<Tails.StateID>() != Tails.StateID.StateGrind &&
            isBoost && rings == maxrings)
        {
            if (!isBoostFixTails)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isBoostFixTails = true;
            }
        }
        else
        {
            isBoostFixTails = false;
        }

        if ((Player.State.GetCurrentStateID<Tails.StateID>() != Tails.StateID.StateGrind) &&
            Player.State.GetPreviousStateID<Tails.StateID>() == Tails.StateID.StateGrind &&
            !isBoost && rings == maxrings)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            {
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
    else if (Player.GetPlayerType() == Player.PlayerType.Amy)
    {
        if ((Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateGrind) &&
            Player.State.GetPreviousStateID<Amy.StateID>() != Amy.StateID.StateGrind &&
            isBoost && rings == maxrings)
        {
            if (!isBoostFixAmy)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isBoostFixAmy = true;
            }
        }
        else
        {
            isBoostFixAmy = false;
        }

        if ((Player.State.GetCurrentStateID<Amy.StateID>() != Amy.StateID.StateGrind) &&
            Player.State.GetPreviousStateID<Amy.StateID>() == Amy.StateID.StateGrind &&
            !isBoost && rings == maxrings)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            {
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
}

//Custom Sounds

Code "Restore Wall Slide Sound" by "Batman Sonic & SuperNova124"
//Restores the wall slide sound

#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Manages pause state
static int conRestoreWallSlide = 0;
static string soundFileName = "";

// Initialization logic
if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conRestoreWallSlide = INI.Parse<int>(ini["Main"]["RestoreWallSlide"], conRestoreWallSlide);

        // Change the sound file based on conRestoreWallSlide
        switch (conRestoreWallSlide)
        {
            case 1:
                soundFileName = "SFX_WallSlide.wav";
                break;
            case 2:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["wallslideVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

// Define wall slide states
List<Sonic.StateID> WallSlideStates = new()
{
    Sonic.StateID.StateWallJumpReady,
    Sonic.StateID.StateWallSlideDown
};

// Check if the player is in a wall slide state
bool isWallSlide = WallSlideStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

if (conRestoreWallSlide == 2)
{
    // Disable sounds
}
else if (isWallSlide)
{
    if (Lua.GetState() != 0 && !soundPlayed)
    {
        // Play the wall slide sound
        sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customAction", soundFileName)));
        sound.Volume = volumeLevel / 100;
        sound.Position = new TimeSpan(0);
        sound.Play();
        soundPlayed = true;
        isPaused = false; // Reset pause state
    }
    else if (isPaused && Lua.GetState() != 0)
    {
        // Resume the sound if it was paused
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed)
    {
        // Stop the sound if not wall sliding
        sound.Stop();
        soundPlayed = false;
    }
}

if (!isWallSlide)
{
    // Ensure soundPlayed is false when not wall sliding
    soundPlayed = false;
}

if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        // Pause the sound when Lua state is 0
        sound.Pause();
        isPaused = true;
    }
}

Code "Custom Homing Reticles" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

#import "States"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conHomingReticle = 0;
static string soundFileName = "";
static IntPtr lastLockOnTarget = IntPtr.Zero; // Track the last lock-on target

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conHomingReticle = INI.Parse<int>(ini["Main"]["HomingReticle"], conHomingReticle);

        // Change the sound file based on conHomingReticle
        switch (conHomingReticle)
        {
            case 1:
                soundFileName = "SFX_LockOnFrontiers.wav";
                break;
            case 2:
                soundFileName = "SFX_LockOnForces2.wav";
                break;
            case 3:
                soundFileName = "SFX_LockOnForces1.wav";
                break;
            case 4:
                soundFileName = "SFX_LockOnLegacy.wav";
                break;
            case 5:
                soundFileName = "SFX_LockOnSecretRings.wav";
                break;
            case 6:
                soundFileName = "SFX_LockOnGamma.wav";
                break;
            case 7:
                soundFileName = "SFX_LockOnOmega.wav";
                break;
            case 8:
                // Disable voices
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["lockonVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

var pGameObject = Player.Status.GetLockOnTarget();
var currentLockOnTarget = new IntPtr(pGameObject);

if (pGameObject != null)
{
    if (Lua.GetState() != 0)
    {
        if (!soundPlayed || currentLockOnTarget != lastLockOnTarget)
        {
            sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customUI", soundFileName)));
            sound.Volume = volumeLevel / 100;
            sound.Position = new TimeSpan(0);
            sound.Play();
            soundPlayed = true;
        }
        else if (isPaused)
        {
            sound.Play();
            isPaused = false;
        }
    }
}
else
{
    if (soundPlayed)
    {
        if (!sound.HasAudio)
        {
            sound.Stop();
            soundPlayed = false;
        }
    }
}

// Reset soundPlayed flag when there is no lock-on target
if (pGameObject == null)
{
    soundPlayed = false;
    isPaused = false; // Reset pause state when not pressing CameraGaze
}

// Update the last lock-on target
lastLockOnTarget = currentLockOnTarget;

if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

