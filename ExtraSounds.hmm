    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;
    
    if (Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateTarotRollingJump)
    {
        if (!isCardSpinJump)
        {
            Player.Sound.PlaySound("sn_lightdash");
            isCardSpinJump = true;
        }
    }
    else
    {
        isCardSpinJump = false;
    }

    //Amy grunts when getting dizzy from spinning her Tarot Cards    
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;
    
    if (Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateTarotRollingStun)
    {
        if (!isCardSpinDizzy)
        {
            Lua.Call("PlayVoice", "sa1048"); 
            isCardSpinDizzy = true;
        }
    }
    else
    {
        isCardSpinDizzy = false;
    }

    //Restore Catch sound in pole swing
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    if (Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateHangPole)
    {
        if (!isHangPole)
        {
            Player.Sound.PlaySound("sn_catch");
            isHangPole = true;
        }
    }
    else
    {
        isHangPole = false;
    }
}

//Additional Sounds

Code "Boost Grunt (Sonic)" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;

static bool isBoostTalk = false;

bool isBoost = IS_STATE_FLAG(IsBoost);
bool isSuperSonic = BlackboardStatus.IsSuper()

static bool IsConfigInitialized = false;
static int conBoostGrunt = 0;

if (!IsConfigInitialized)
{
    var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
    if (modsQuery.Count == 1)
    {
        string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conBoostGrunt = INI.Parse<int>(ini["Main"]["BoostGrunt"], conBoostGrunt);

        IsConfigInitialized = true;
    }
}

if (conBoostGrunt == 1 || conBoostGrunt == 2)
{
    if ((isBoost && !isSuperSonic && Player.State.GetCurrentStateID<Sonic.StateID>() != Sonic.StateID.StateSpinBoost) || (conBoostGrunt == 2 && Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinBoost))
    {
        if (!isBoostTalk)
        {
            if (Player.GetPlayerType() == Player.PlayerType.Sonic)
            {
                List<string> boostVoices = new List<string>{"sa1039", "sa1040", "sa1041", "sa1051"};
                if (conBoostGrunt == 2 && Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinBoost)
                {
                    boostVoices.Add("sa1008");
                }
                int randomIndex = new Random().Next(boostVoices.Count);
                string selectedVoice = boostVoices[randomIndex];
                Lua.Call("PlayVoice", selectedVoice);
            }
            isBoostTalk = true;
        }
    }
    else
    {
        isBoostTalk = false;
    }
}
// Disable sounds
else if (conBoostGrunt == 3)
{
    // Disable sounds
}

