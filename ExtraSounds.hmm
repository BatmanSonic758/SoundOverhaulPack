Code "Restore Zero Rings Warning" by "Batman Sonic & SuperNova124"
// Restores an unused warning sound that plays when the player has zero rings

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "BlackboardItem"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;

// Configuration cache
static bool? configInitCache = null;
static int conZeroRingWarning = 0;

// State tracking
static bool hadRingsBefore = false;
static bool isRingWarning = false;
static int soundRingUp = 0;

// CRITICAL FIX: Static damage states list (was being created every frame!)
static List<Sonic.StateID> DamageStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateDamage,
    Sonic.StateID.StateDamageBlowOff,
    Sonic.StateID.StateDamageBlowOffHeavy,
    Sonic.StateID.StateDamageLava,
    Sonic.StateID.StateDamageQuake,
    Sonic.StateID.StateDamageRoot,
    Sonic.StateID.StateDamageRunning,
    Sonic.StateID.StateDamageTurnBack,
    Sonic.StateID.StateDivingDamage,
    Sonic.StateID.StateDivingSpecialDamage,
    Sonic.StateID.StateGrindDamage,
    Sonic.StateID.StateGrindDamageAir,
    Sonic.StateID.StateUpDownPoleDamage
};

{
    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conZeroRingWarning = INI.Parse<int>(ini["Main"]["ZeroRingWarning"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
                return;
            }
        }
        else
        {
            configInitCache = false;
            return;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conZeroRingWarning != 1)
        return;

    // Get blackboard
    var pBlackboardItem = BlackboardItem.Get();
    if (pBlackboardItem == null)
        return;

    // Cache checks
    int rings = pBlackboardItem->RingCount;
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    bool isDamage = DamageStates.Contains(currentState);

    // Player has zero rings and is taking damage
    if (rings == 0 && isDamage)
    {
        // Play sound only when player HAD rings before
        if (hadRingsBefore && !isRingWarning)
        {
            soundRingUp = Player.Sound.PlaySound("sys_ring_zero_warning");
            isRingWarning = true;
        }
        // Reset "had rings" flag
        hadRingsBefore = false;
    }
    // Player has at least 1 ring
    else if (rings >= 1)
    {
        // Set flag indicating player has rings
        hadRingsBefore = true;

        // Stop warning sound if playing
        if (isRingWarning)
        {
            int tempSoundHandle = soundRingUp;
            Player.Sound.StopSound(&tempSoundHandle);
            isRingWarning = false;
        }
    }
}

Code "Restore Zero Rings Warning (Tutorial)" by "Batman Sonic & SuperNova124"
// Restores zero rings warning sound for tutorial stage

#lib "Player"
#lib "BlackboardItem"
#lib "HMM"
#lib "INI"

#import "Postures"
#import "Services"

// Configuration cache
static bool? configInitCache = null;
static int conZeroRingWarning = 0;

// State tracking
static bool isRingWarning = false;
static int soundRingUp = 0;

{
    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conZeroRingWarning = INI.Parse<int>(ini["Main"]["ZeroRingWarning"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
                return;
            }
        }
        else
        {
            configInitCache = false;
            return;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conZeroRingWarning != 1)
        return;

    // Only run in tutorial stage
    if (LevelInfo.GetCurrentStageID() != "w1r02_1")
        return;

    // Get blackboard
    var pBlackboardItem = BlackboardItem.Get();
    if (pBlackboardItem == null)
        return;

    // Get ring count
    int rings = pBlackboardItem->RingCount;

    // Player has zero rings
    if (rings == 0)
    {
        // Play sound if not already playing
        if (!isRingWarning)
        {
            soundRingUp = Player.Sound.PlaySound("sys_ring_zero_warning");
            isRingWarning = true;
        }
    }
    // Player has at least 1 ring
    else if (rings >= 1)
    {
        // Stop sound if playing
        if (isRingWarning)
        {
            int tempSoundHandle = soundRingUp;
            Player.Sound.StopSound(&tempSoundHandle);
            isRingWarning = false;
        }
    }
}

Code "Somersault when hitting wall terrain" by "Batman Sonic & SuperNova124"
