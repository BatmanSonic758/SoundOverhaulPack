Code "Additional Drift Sound for Amy" by "Batman Sonic & SuperNova124"
// Adds Sonic's drifting sound to Amy's Tarot Card Drift

#include "Reflection" noemit

#lib "Player"
#lib "Amy"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;

// Configuration cache
static bool? configInitCache = null;
static int conAmyDrift = 0;

// State tracking
static bool isAmyDriftExtra = false;

{
    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conAmyDrift = INI.Parse<int>(ini["Main"]["AmyDrift"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
                return;
            }
        }
        else
        {
            configInitCache = false;
            return;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conAmyDrift != 1)
        return;

    // Early exit if not Amy
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    // Cache state checks
    var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
    var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

    // Entering tarot drift
    if (currentState == Amy.StateID.AmyStateTarotDrift &&
        previousState != Amy.StateID.AmyStateTarotDrift)
    {
        if (!isAmyDriftExtra)
        {
            Player.Sound.PlaySound("sn_drift");
            isAmyDriftExtra = true;
        }
    }
    // Exiting tarot drift
    else if (currentState != Amy.StateID.AmyStateTarotDrift &&
             previousState == Amy.StateID.AmyStateTarotDrift)
    {
        if (isAmyDriftExtra)
        {
            int soundHandle = Player.Sound.PlaySound("sn_drift");
            Player.Sound.StopSound(&soundHandle);
            isAmyDriftExtra = false;
        }
    }
    // Reset flag when not in drift
    else if (currentState != Amy.StateID.AmyStateTarotDrift)
    {
        isAmyDriftExtra = false;
    }
}

Code "Restore Wall Slide" by "Batman Sonic & SuperNova124"
// Adds a sliding sound to Sonic's wall jump, like in previous games

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"

#load "System.Numerics.dll"

using System.Numerics;

// State tracking
static bool isSonicWallSlide = false;

{
    // Early exit if not Sonic
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    // Get current state ONCE
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    
    // Are we in wall jump ready?
    bool inWallJumpReady = (currentState == Sonic.StateID.StateWallJumpReady);

    // CASE 1: In wall jump ready
    if (inWallJumpReady)
    {
        // Only play sound if not already playing
        if (!isSonicWallSlide)
        {
            Player.Sound.PlaySound("sn_sliding");
            isSonicWallSlide = true;
        }
        // Already playing, do nothing
    }
    // CASE 2: Not in wall jump ready
    else
    {
        // Only stop if sound was playing
        if (isSonicWallSlide)
        {
            int soundHandle = Player.Sound.PlaySound("sn_sliding");
            Player.Sound.StopSound(&soundHandle);
            isSonicWallSlide = false;
        }
        // Wasn't playing, do nothing
    }
}

