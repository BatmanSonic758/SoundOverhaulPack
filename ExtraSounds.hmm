Code "StateSpin / StateDriftDash Missing Sounds Fix" by "Batman Sonic & SuperNova124"
// Adds missing spin sounds to certain states

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Sonic"
#lib "HMM"

#import "States"

#load "System.Numerics.dll"

using System.Numerics;

// State tracking
static bool isSpinSound = false;

// Check if Quality of Life Additions is active (static, checked once)
static bool? qolCheckCache = null;

{
    // Check QoL mod once
    if (qolCheckCache == null)
    {
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    }

    // Exit early if QoL is active
    if (qolCheckCache == true)
        return;

    // Get current state ONCE
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    // Quick check: are we in a spin state?
    bool inSpinState = (currentState == Sonic.StateID.StateSpin ||
                       currentState == Sonic.StateID.StateDropDash ||
                       currentState == Sonic.StateID.StateDriftDash);

    // CASE 1: In a spin state
    if (inSpinState)
    {
        // Only play sound if not already playing
        if (!isSpinSound)
        {
            Player.Sound.PlaySound("sn_spinboost");
            isSpinSound = true;
        }
        // Already playing, do nothing
    }
    // CASE 2: Not in a spin state
    else
    {
        // Only stop if sound was playing
        if (isSpinSound)
        {
            int soundHandle = Player.Sound.PlaySound("sn_spinboost");
            Player.Sound.StopSound(&soundHandle);
            isSpinSound = false;
        }
        // Wasn't playing, do nothing
    }
}

Code "Consistent Grand Slam Sound" by "Batman Sonic & SuperNova124"
//Grand Slam sound depends on your current Spin Dash sound preset

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "HMM"
#lib "INI"

#import "States"

using System.IO;

// Configuration cache
static bool? configInitCache = null;
static int conSpinDashSound = 0;
static int conSpinDashAirSound = 0;
static int conSpinDashChargeFaithful = 0;

// 0 = idle, 1 = playing charge, 2 = playing spin, 3 = done
static int smashSoundPhase = 0;
static float smashSoundTimer = 0.0f;

static int smashChargeHandle = 0;
static int smashSpinHandle   = 0;
static bool smashChargeAltToggle = false;
static bool smashReleaseAltToggle = false;

static int smashPoseHandle = 0;
static bool smashPoseActive = false;

// 0 = idle, 1 = playing charge, 3 = done
static int smashSSSoundPhase = 0;
static float smashSSSoundTimer = 0.0f;

static int smashSSChargeHandle = 0;
static bool smashSSChargeAltToggle = false;

static int smashSSPoseHandle = 0;
static bool smashSSPoseActive = false;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");
        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");
            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conSpinDashSound =
                    INI.Parse<int>(ini["Main"]["SpinDashSound"], 0);
                conSpinDashAirSound =
                    INI.Parse<int>(ini["Main"]["SpinDashAirSound"], 0);
                conSpinDashChargeFaithful =
                    INI.Parse<int>(ini["Main"]["SpinDashChargeFaithful"], 0);
            }
        }
        configInitCache = true;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    bool isAir = !Player.Status.IsGrounded();

    // --- StateSmash ---
    if (currentState == Sonic.StateID.StateSmash)
    {
        smashSoundTimer += Time.GetDeltaTime();

        if (smashSoundPhase == 0)
        {
            string chargeSound;
            switch (conSpinDashSound)
            {
                case 1:
                case 2:
                default:
                    chargeSound = "sn_spinboost_charge_rangers";
                    break;
                case 3:
                    chargeSound = "sn_spinboost_charge_swa";
                    break;
                case 4:
                    chargeSound = "sn_spinboost_charge_sxsg";
                    break;
                case 5:
                    chargeSound = "sn_spinboost_charge_miller";
                    break;
                case 6:
                    chargeSound = "sn_spinboost_charge_next";
                    break;
                case 7:
                    chargeSound = "sn_spinboost_charge_sa1";
                    break;
                case 8:
                    smashChargeAltToggle = !smashChargeAltToggle;
                    chargeSound = smashChargeAltToggle ?
                        "sn_spinboost_charge_brawl_1st" :
                        "sn_spinboost_charge_brawl_2nd";
                    break;
                case 9:
                    chargeSound = "sn_spinboost_charge_ultimate";
                    break;
            }
            smashChargeHandle = Player.Sound.PlaySound(chargeSound);
            smashSoundPhase   = 1;
        }
        else if (smashSoundPhase == 1 && smashSoundTimer >= 0.4f)
        {
            int chargeHandle  = smashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            smashChargeHandle = 0;

            string releaseSound;
            switch (conSpinDashSound)
            {
                case 1:
                case 2:
                case 3:
                default:
                    releaseSound = "sn_spinboost_rangers";
                    break;
                case 4:
                    releaseSound = "sn_spinboost_sxsg";
                    break;
                case 5:
                    smashReleaseAltToggle = !smashReleaseAltToggle;
                    releaseSound = smashReleaseAltToggle ?
                        "sn_spinboost_miller_1st" :
                        "sn_spinboost_miller_2nd";
                    break;
                case 6:
                    releaseSound = "sn_spinboost_next";
                    break;
                case 7:
                    releaseSound = "sn_spinboost_sa1";
                    break;
                case 8:
                    releaseSound = "sn_spinboost_brawl";
                    break;
                case 9:
                    releaseSound = "sn_spinboost_ultimate";
                    break;
            }
            smashSpinHandle = Player.Sound.PlaySound(releaseSound);
            smashSoundPhase = 2;
        }
        else if (smashSoundPhase == 2 && smashSoundTimer >= 0.4f + 1.2f)
        {
            int spinHandle  = smashSpinHandle;
            Player.Sound.StopSound(&spinHandle);
            smashSpinHandle = 0;

            smashSoundPhase = 3;
        }

        bool smashFaithfulActive = smashSoundPhase == 1 &&
            (!isAir || conSpinDashAirSound == 4) &&
            conSpinDashChargeFaithful == 1 &&
            (conSpinDashSound == 1 || conSpinDashSound == 2 || conSpinDashSound == 3);

        if (smashFaithfulActive)
        {
            if (!smashPoseActive)
            {
                smashPoseHandle = Player.Sound.PlaySound("sn_spinboost_charge_pose");
                smashPoseActive = true;
            }
        }
        else
        {
            if (smashPoseActive)
            {
                int poseHandle  = smashPoseHandle;
                Player.Sound.StopSound(&poseHandle);
                smashPoseActive = false;
            }
        }
    }
    else
    {
        if (smashSoundPhase == 1)
        {
            int chargeHandle  = smashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            smashChargeHandle = 0;
        }
        else if (smashSoundPhase == 2)
        {
            int spinHandle  = smashSpinHandle;
            Player.Sound.StopSound(&spinHandle);
            smashSpinHandle = 0;
        }

        if (smashPoseActive)
        {
            int poseHandle  = smashPoseHandle;
            Player.Sound.StopSound(&poseHandle);
            smashPoseActive = false;
        }

        smashSoundPhase = 0;
        smashSoundTimer = 0.0f;
    }

    // --- StateSmashSS ---
    if (currentState == Sonic.StateID.StateSmashSS)
    {
        smashSSSoundTimer += Time.GetDeltaTime();

        if (smashSSSoundPhase == 0)
        {
            string chargeSoundSS;
            switch (conSpinDashSound)
            {
                case 1:
                case 2:
                default:
                    chargeSoundSS = "sn_spinboost_charge_rangers";
                    break;
                case 3:
                    chargeSoundSS = "sn_spinboost_charge_swa";
                    break;
                case 4:
                    chargeSoundSS = "sn_spinboost_charge_sxsg";
                    break;
                case 5:
                    chargeSoundSS = "sn_spinboost_charge_miller";
                    break;
                case 6:
                    chargeSoundSS = "sn_spinboost_charge_next";
                    break;
                case 7:
                    chargeSoundSS = "sn_spinboost_charge_sa1";
                    break;
                case 8:
                    smashSSChargeAltToggle = !smashSSChargeAltToggle;
                    chargeSoundSS = smashSSChargeAltToggle ?
                        "sn_spinboost_charge_brawl_1st" :
                        "sn_spinboost_charge_brawl_2nd";
                    break;
                case 9:
                    chargeSoundSS = "sn_spinboost_charge_ultimate";
                    break;
            }
            smashSSChargeHandle = Player.Sound.PlaySound(chargeSoundSS);
            smashSSSoundPhase   = 1;
        }
        else if (smashSSSoundPhase == 1 && smashSSSoundTimer >= 2.10f)
        {
            int chargeHandle    = smashSSChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            smashSSChargeHandle = 0;

            smashSSSoundPhase = 3;
        }

        bool smashSSFaithfulActive = smashSSSoundPhase == 1 &&
            (!isAir || conSpinDashAirSound == 4) &&
            conSpinDashChargeFaithful == 1 &&
            (conSpinDashSound == 1 || conSpinDashSound == 2 || conSpinDashSound == 3);

        if (smashSSFaithfulActive)
        {
            if (!smashSSPoseActive)
            {
                smashSSPoseHandle = Player.Sound.PlaySound("sn_spinboost_charge_pose");
                smashSSPoseActive = true;
            }
        }
        else
        {
            if (smashSSPoseActive)
            {
                int poseHandle  = smashSSPoseHandle;
                Player.Sound.StopSound(&poseHandle);
                smashSSPoseActive = false;
            }
        }
    }
    else
    {
        if (smashSSSoundPhase == 1)
        {
            int chargeHandle    = smashSSChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            smashSSChargeHandle = 0;
        }

        if (smashSSPoseActive)
        {
            int poseHandle  = smashSSPoseHandle;
            Player.Sound.StopSound(&poseHandle);
            smashSSPoseActive = false;
        }

        smashSSSoundPhase = 0;
        smashSSSoundTimer = 0.0f;
    }
}

Code "Consistent Spin Slash Sound" by "Batman Sonic & SuperNova124"
//Spin Slash sound depends on your current Spin Dash sound preset

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "HMM"
#lib "INI"

#import "States"

using System.IO;

// Configuration cache
static bool? configInitCache = null;
static int conSpinDashSound = 0;
static int conSpinDashAirSound = 0;
static int conSpinDashChargeFaithful = 0;

// 0 = idle, 1 = playing charge, 3 = done
static int spinSlashSoundPhase = 0;
static float spinSlashSoundTimer = 0.0f;

static int spinSlashChargeHandle = 0;
static bool spinSlashChargeAltToggle = false;

static int spinSlashPoseHandle = 0;
static bool spinSlashPoseActive = false;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");
        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");
            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conSpinDashSound =
                    INI.Parse<int>(ini["Main"]["SpinDashSound"], 0);
                conSpinDashAirSound =
                    INI.Parse<int>(ini["Main"]["SpinDashAirSound"], 0);
                conSpinDashChargeFaithful =
                    INI.Parse<int>(ini["Main"]["SpinDashChargeFaithful"], 0);
            }
        }
        configInitCache = true;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    bool isAir = !Player.Status.IsGrounded();

    if (currentState == Sonic.StateID.StateSpinSlash)
    {
        bool isSuper = BlackboardStatus.IsSuper();
        float duration = isSuper ? 0.45f : 1.0f;

        spinSlashSoundTimer += Time.GetDeltaTime();

        if (spinSlashSoundPhase == 0)
        {
            string chargeSound;
            switch (conSpinDashSound)
            {
                case 1:
                case 2:
                default:
                    chargeSound = "sn_spinboost_charge_rangers";
                    break;
                case 3:
                    chargeSound = "sn_spinboost_charge_swa";
                    break;
                case 4:
                    chargeSound = "sn_spinboost_charge_sxsg";
                    break;
                case 5:
                    chargeSound = "sn_spinboost_charge_miller";
                    break;
                case 6:
                    chargeSound = "sn_spinboost_charge_next";
                    break;
                case 7:
                    chargeSound = "sn_spinboost_charge_sa1";
                    break;
                case 8:
                    spinSlashChargeAltToggle = !spinSlashChargeAltToggle;
                    chargeSound = spinSlashChargeAltToggle ?
                        "sn_spinboost_charge_brawl_1st" :
                        "sn_spinboost_charge_brawl_2nd";
                    break;
                case 9:
                    chargeSound = "sn_spinboost_charge_ultimate";
                    break;
            }
            spinSlashChargeHandle = Player.Sound.PlaySound(chargeSound);
            spinSlashSoundPhase   = 1;
        }
        else if (spinSlashSoundPhase == 1 && spinSlashSoundTimer >= duration)
        {
            int chargeHandle = spinSlashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            spinSlashChargeHandle = 0;

            spinSlashSoundPhase = 3;
        }

        bool spinSlashFaithfulActive = spinSlashSoundPhase == 1 &&
            (!isAir || conSpinDashAirSound == 4) &&
            conSpinDashChargeFaithful == 1 &&
            (conSpinDashSound == 1 || conSpinDashSound == 2 || conSpinDashSound == 3);

        if (spinSlashFaithfulActive)
        {
            if (!spinSlashPoseActive)
            {
                spinSlashPoseHandle = Player.Sound.PlaySound("sn_spinboost_charge_pose");
                spinSlashPoseActive = true;
            }
        }
        else
        {
            if (spinSlashPoseActive)
            {
                int poseHandle = spinSlashPoseHandle;
                Player.Sound.StopSound(&poseHandle);
                spinSlashPoseActive = false;
            }
        }
    }
    else
    {
        if (spinSlashSoundPhase == 1)
        {
            int chargeHandle = spinSlashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            spinSlashChargeHandle = 0;
        }

        if (spinSlashPoseActive)
        {
            int poseHandle = spinSlashPoseHandle;
            Player.Sound.StopSound(&poseHandle);
            spinSlashPoseActive = false;
        }

        spinSlashSoundPhase = 0;
        spinSlashSoundTimer = 0.0f;
    }
}

Code "Disable Drowning Jingle" by "Batman Sonic" does "Restricts bgm_jingle_drown from playing when trapped in the Balloon enemy"
//
    #include "Reflection" noemit

    #lib "Reflection"
    #lib "SoundCommonParameter"
//
{
    var SoundCommonParameterInfo = Reflection.GetDataInfo<SoundCommonParameter.Root>("sound_common_param");

    if (SoundCommonParameterInfo.pData == null)
        return;

    for (int i = 0; i < 128; i++)
    {
        if (SoundCommonParameterInfo.pData->changeBgmInfo[i].cueName != "bgm_jingle_drown")
            continue;

        RFL_SET_PARAM(SoundCommonParameterInfo, changeBgmInfo[i].priority, SoundCommonParameter.Priority.PRIORITY_LOW);

        break;
    }
}