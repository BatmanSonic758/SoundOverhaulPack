Code "Lua Sound" by "Batman Sonic" does "Loads .level files related to sound"
//
	#include "BlackboardStatus" noemit
	
	#lib "Lua"
//
{	
    // Credit to Weezley for the original 'Fix Another Story Stages Sound' code
    Lua.Call("LoadLevel", "extra_sound");
	
    if (IS_WORLD_FLAG(IsCyberSpace) || !IS_WORLD_FLAG(IsCyberSpace))
	{
		// Update 3 Object SFX
		Lua.Call("LoadLevel", "extra_cyber_sound");
		
	}	
    if (!IS_WORLD_FLAG(IsCyberSpace))
	{
		// Cyber Space SFX for Jump Panel
		Lua.Call("LoadLevel", "w6_sound");
	}
}

Code "Extra Sounds (Sonic the Hedgehog)" by "Batman Sonic & SuperNova124"
//
    #lib "Player"
    #lib "Sonic"
    #lib "Lua"
    #lib "BlackboardStatus"
    #lib "HMM"
    
    #import "Services"
    
    #load "System.Numerics.dll"

    using System.Numerics;
    using System.Collections.Generic;

    // Static lists - initialized once, not every frame
    static List<Sonic.StateID> QuickStepStates = new List<Sonic.StateID>
    {
        Sonic.StateID.StateLeftStep,
        Sonic.StateID.StateLeftStepRun,
        Sonic.StateID.StateRightStep,
        Sonic.StateID.StateRightStepRun,
        Sonic.StateID.StateQuickStepLeft,
        Sonic.StateID.StateQuickStepRight,
        Sonic.StateID.StateQuickStepRoot,
    };

    static List<string> driftVoices = new List<string>{"sa1010", "sa1024", "sa1038", "sa1013_1"};
    static List<string> lightdashVoices = new List<string>{"sa1038", "sa1039", "sa1040", "sa1041", "sa1051", "sa1056"};
    static List<string> slidingVoices = new List<string>{"sa1021_1", "sa1021_2", "sa1009", "sa1011", "sa1034", "sa1024"};
    static List<string> quickstepVoices = new List<string>{"sa1014_1", "sa1004", "sa1005", "sa1007", "sa1009", "sa1038"};
    static List<string> guardedflipVoices = new List<string>{"sa1047", "sa1048", "sa1049", "sa1025"};
    static List<string> auratrainVoices = new List<string>{"sa1040", "sa1041"};

    // Single Random instance
    static Random random = new Random();

    // State flags
    static bool isAttackWindmill = false;
    static bool isCycloneKick = false;   
    static bool isCrossSlash = false;        
    static bool isPursuitKick = false;    
    static bool isTakeDamage = false;    
    static bool isTakeDamageMisc = false;   
    static bool isBoxPush = false;      
    static bool isBoxKick = false;      
    static bool isSomersaultLand = false; 
    static bool isGrindStep = false;
    static bool isSpinJump = false;
    static bool isDoubleJumpGrunt = false;
    static bool isGrindJumpGrunt = false;
    static bool isStompAttack = false;
    static bool isStompPress = false;
    static bool isStompBounce = false;
    static bool isStompFlip = false;
    static bool isSquatGrunt = false;
    static bool isDeath = false;
    static bool isDeathLava = false;
    static bool isDashRamp = false;
    static bool isTrickFinish = false;
    static bool isDriftGrunt =  false;
    static bool isClimbGrunt = false;
    static bool isBreatheGrunt = false;
    static bool isAnimalJump = false;
    static bool isKocoJump = false;
    static bool isPipeHotfix = false;
    static bool isSuperSonicBrakeFix = false;
    static bool isWallSlide = false;
    static bool isHangPole = false;
    static bool isLightDash = false;
    static bool isSliding = false;
    static bool isQuickStep = false;
    static bool isGaurdBlock = false;
    static bool isAuraTrain = false;

    // Cache QoL check result
    static bool? qolCheckCache = null;

//
{
    // Check QoL only once
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    // Single player type check at the start
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;
    
    // Cache state IDs - call once per frame
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    bool isSuper = BlackboardStatus.IsSuper();
    bool isUnderwater = Player.Status.IsUnderwater();
    string currentStageID = LevelInfo.GetCurrentStageID();

    // Windmill Kick
    if (currentState == Sonic.StateID.StateHomingFinish)
    {
        if (!isAttackWindmill)
        {
            Lua.Call("PlayVoice", "sa1013_1");
            Player.Sound.PlaySound("sn_triangle_jump");
            Player.Sound.PlaySound("sn_finish_attack1");
            isAttackWindmill = true;
        }
    }
    else
        isAttackWindmill = false;

    // Cyclone Kick
    if (currentState == Sonic.StateID.StateChargeAttack)
    {
        if (!isCycloneKick)
        {
            Lua.Call("PlayVoice", "sa1016");
            isCycloneKick = true;
        }
    }
    else
        isCycloneKick = false;

    // Pursuit Kick
    if (currentState == Sonic.StateID.StatePursuitKick)
    {
        if (!isPursuitKick)
        {
            Player.Sound.PlaySound("blank");
            Lua.Call("PlayVoice", "blank");
            isPursuitKick = true;
        }
    }
    else
        isPursuitKick = false;

    // Cross Slash
    if (currentState == Sonic.StateID.StateCrossSlash)
    {
        if (!isCrossSlash)
        {
            Lua.Call("PlayVoice", "sa1016");
            isCrossSlash = true;
        }
    }
    else
        isCrossSlash = false;

    // Damage
    if (currentState == Sonic.StateID.StateDamage)
    {
        if (!isTakeDamage)
        {
            Lua.Call("PlayVoice", "sa1026");
            isTakeDamage = true;
        }
    }
    else
        isTakeDamage = false;

    // Damage (misc)
    if (currentState == Sonic.StateID.StateDamageRunning ||
        currentState == Sonic.StateID.StateGrindDamage ||
        currentState == Sonic.StateID.StateGrindDamageAir ||
        currentState == Sonic.StateID.StateDivingDamage ||
        currentState == Sonic.StateID.StateDivingSpecialDamage)
    {
        if (!isTakeDamageMisc)
        {
            Player.Sound.PlaySound("sn_damage");
            Lua.Call("PlayVoice", "sa1026");
            isTakeDamageMisc = true;
        }
    }
    else
        isTakeDamageMisc = false;

    // Somersault Landing
    if (currentState == Sonic.StateID.StateSpringJumpHeadLand)
    {
        if (!isSomersaultLand)
        {
            Player.Sound.PlaySound("sn_bump_jump_roll");
            Lua.Call("PlayVoice", "sa1009");
            isSomersaultLand = true;
        }
    }
    else
        isSomersaultLand = false;

    // Push Box
    if (currentState == Sonic.StateID.StatePushBox)
    {
        if (!isBoxPush)
        {
            Lua.Call("PlayVoice", "sa1036");
            isBoxPush = true;
        }
    }
    else
        isBoxPush = false;

    // Kick Box
    if (currentState == Sonic.StateID.StateKickBox)
    {
        if (!isBoxKick)
        {
            Player.Sound.PlaySound("obj_brk_standlight02");
            Player.Sound.PlaySound("sn_attack_hit_s");
            Player.Sound.PlaySound("sn_windmill_kick");
            Lua.Call("PlayVoice", "sa1038");
            isBoxKick = true;
        }
    }
    else
        isBoxKick = false;

    // Grind Step
    if (currentState == Sonic.StateID.StateGrindStep)
    {
        if (!isGrindStep)
        {
            Player.Sound.PlaySound("sn_triangle_jump");
            Lua.Call("PlayVoice", "sa1007");
            isGrindStep = true;
        }
    }
    else
        isGrindStep = false;

    // Spin Jump
    if (currentState == Sonic.StateID.StateJump ||
        currentState == Sonic.StateID.StateBaseJump ||
        currentState == Sonic.StateID.StateTreeJump)
    {
        if (!isSpinJump)
        {
            Player.Sound.PlaySound("sn_windmill_kick");
            Lua.Call("PlayVoice", "sa1003");
            isSpinJump = true;
        }
    }
    else
        isSpinJump = false;

    // Double Jump
    if (currentState == Sonic.StateID.StateDoubleJump)
    {
        if (!isDoubleJumpGrunt)
        {
            Lua.Call("PlayVoice", "sa1005");
            isDoubleJumpGrunt = true;
        }
    }
    else
        isDoubleJumpGrunt = false;

    // Grind Jump
    if (currentState == Sonic.StateID.StateGrindJump)
    {
        if (!isGrindJumpGrunt)
        {
            Lua.Call("PlayVoice", "sa1003");
            isGrindJumpGrunt = true;
        }
    }
    else
        isGrindJumpGrunt = false;

    // Stomp Attack
    if (currentState == Sonic.StateID.StateStompingDown)
    {
        if (!isStompAttack)
        {
            Player.Sound.PlaySound("_sn_stomping_start");
            Lua.Call("PlayVoice", "sa1021_2");
            isStompAttack = true;
        }
    }
    else
        isStompAttack = false;

    // Stomping Press
    if (currentState == Sonic.StateID.StateStompingPress)
    {
        if (!isStompPress)
        {
            Player.Sound.PlaySound("sn_collision");
            Lua.Call("PlayVoice", "sa1016");
            isStompPress = true;
        }
    }
    else
        isStompPress = false;

    // Stomping Bounce
    if (currentState == Sonic.StateID.StateStompingBounce)
    {
        if (!isStompBounce)
        {
            Player.Sound.PlaySound("sn_windmill_kick");
            Lua.Call("PlayVoice", "sa1056");
            isStompBounce = true;
        }
    }
    else
        isStompBounce = false;

    // Stomp Flip
    if (currentState == Sonic.StateID.StateStomping)
    {
        if (!isStompFlip)
        {
            Player.Sound.PlaySound("sn_jump");
            isStompFlip = true;
        }
    }
    else
        isStompFlip = false;

    // Squat
    if (currentState == Sonic.StateID.StateSquat)
    {
        if (!isSquatGrunt)
        {
            Player.Sound.PlaySound("sn_climb_jump");
            Lua.Call("PlayVoice", "sa1007");
            isSquatGrunt = true;
        }
    }
    else
        isSquatGrunt = false;

    // Death
    if (currentState == Sonic.StateID.StateDead)
    {
        if ((!isSuper || !isUnderwater) && !isDeath)
        {
            Lua.Call("PlayVoice", "sa1027");
            isDeath = true;
        }
    }
    else
        isDeath = false;

    // Lava Death
    if (currentState == Sonic.StateID.StateLavaDead)
    {
        if (!isDeathLava)
        {
            Lua.Call("PlayVoice", "sa1028");
            isDeathLava = true;
        }
    }
    else
        isDeathLava = false;

    // Trick Finish
    if (currentState == Sonic.StateID.StateRecoveryJump && previousState != Sonic.StateID.StateHomingFinished)
    {
        if (!isTrickFinish)
        {
            Player.Sound.PlaySound("sn_climb_balance_ok");
            Lua.Call("PlayVoice", "sa1009");
            isTrickFinish = true;
        }
    }
    else if (currentState != Sonic.StateID.StateHomingAttack || previousState != Sonic.StateID.StateRecoveryJump)
        isTrickFinish = false;

    // Drift
    if (currentState == Sonic.StateID.StateDrift || currentState == Sonic.StateID.StateDriftAir)
    {
        if (!isDriftGrunt)
        {
            Player.Sound.PlaySound("sn_quick_turn");
            Lua.Call("PlayVoice", driftVoices[random.Next(driftVoices.Count)]);
            isDriftGrunt = true;
        }
    }
    else
        isDriftGrunt = false;

    // Wall Climb
    if (currentState == Sonic.StateID.StateWallMove)
    {
        if (!isClimbGrunt)
        {
            Lua.Call("PlayVoice", "sa1002");
            isClimbGrunt = true;
        }
    }
    else
        isClimbGrunt = false;

    // Breathe (exiting water)
    if (isUnderwater)
        isBreatheGrunt = false;
    else if (!isBreatheGrunt)
    {
        Lua.Call("PlayVoice", "sa1033");
        isBreatheGrunt = true;
    }

    // Koco Jump
    if (currentState == Sonic.StateID.StateJumpWithKodama)
    {
        if (!isKocoJump)
        {
            Lua.Call("PlayVoice", "sa1003");
            isKocoJump = true;
        }
    }
    else
        isKocoJump = false;

    // Animal Jump
    if (currentState == Sonic.StateID.StateJumpWithAnimal)
    {
        if (!isAnimalJump)
        {
            Lua.Call("PlayVoice", "sa1003");
            isAnimalJump = true;
        }
    }
    else
        isAnimalJump = false;

    // Dash Ramp
    bool disableSoundFlag = currentStageID == "w7d03" || currentStageID == "w7d07";
    if (currentState == Sonic.StateID.StateJumpBoardLaunch)
    {
        if (!isDashRamp && !disableSoundFlag &&
            previousState != Sonic.StateID.StateBoarding &&
            currentState != Sonic.StateID.StateBoarding)
        {
            Player.Sound.PlaySound("obj_testtone");
            isDashRamp = true;
        }
    }
    else
        isDashRamp = false;

    // Pipe Hotfix (4-6)
    if (currentState == Sonic.StateID.StateCaught && currentStageID == "w7d07")
    {
        if (!isPipeHotfix)
        {
            Player.Sound.PlaySound("obj_s_tunnel");
            isPipeHotfix = true;
        }
    }
    else
        isPipeHotfix = false;

    // Super Sonic Brake
    if (currentState == Sonic.StateID.StateFlyTurn)
    {
        if (!isSuperSonicBrakeFix)
        {
            Player.Sound.PlaySound("sn_quick_turn");
            Lua.Call("PlayVoice", "sa1007");
            isSuperSonicBrakeFix = true;
        }
    }
    else
        isSuperSonicBrakeFix = false;

    // Wall Slide
    if (currentState == Sonic.StateID.StateWallJumpReady)
    {
        if (!isWallSlide)
        {
            Player.Sound.PlaySound("sn_land_conc");
            isWallSlide = true;
        }
    }
    else
        isWallSlide = false;

    // Hang Pole
    if (currentState == Sonic.StateID.StateHangPole)
    {
        if (!isHangPole)
        {
            Player.Sound.PlaySound("sn_catch");
            isHangPole = true;
        }
    }
    else
        isHangPole = false;

    // Light Dash
    if (currentState == Sonic.StateID.StateLightDash)
    {
        if (!isLightDash)
        {
            Lua.Call("PlayVoice", lightdashVoices[random.Next(lightdashVoices.Count)]);
            isLightDash = true;
        }
    }
    else
        isLightDash = false;

    // Sliding
    if (currentState == Sonic.StateID.StateSliding)
    {
        if (!isSliding)
        {
            Lua.Call("PlayVoice", slidingVoices[random.Next(slidingVoices.Count)]);
            isSliding = true;
        }
    }
    else
        isSliding = false;

    // Quick Step
    bool isInQuickStep = QuickStepStates.Contains(currentState) || 
                         (isSuper && currentState == Sonic.StateID.StateAvoid);
    if (isInQuickStep)
    {
        if (!isQuickStep)
        {
            Lua.Call("PlayVoice", quickstepVoices[random.Next(quickstepVoices.Count)]);
            isQuickStep = true;
        }
    }
    else
        isQuickStep = false;

    // Guard Block
    if (!isSuper && currentState == Sonic.StateID.StateGuardedFlipBack)
    {
        if (!isGaurdBlock)
        {
            Lua.Call("PlayVoice", guardedflipVoices[random.Next(guardedflipVoices.Count)]);
            isGaurdBlock = true;
        }
    }
    else
        isGaurdBlock = false;

    // Aura Train
    if (currentState == Sonic.StateID.StateAuraTrain)
    {
        if (!isAuraTrain)
        {
            Lua.Call("PlayVoice", auratrainVoices[random.Next(auratrainVoices.Count)]);
            isAuraTrain = true;
        }
    }
    else
        isAuraTrain = false;
}

Code "Extra Sounds (Miles "Tails" Prower)" by "Batman Sonic & SuperNova124"
//
    #lib "Player"
    #lib "Tails"
    #lib "Lua"
    #lib "HMM"
    
    #load "System.Numerics.dll"

    using System.Numerics;
    using System.Collections.Generic;

    // Static lists
    static List<Tails.StateID> QuickStepStates = new List<Tails.StateID>
    {
        Tails.StateID.StateLeftStep,
        Tails.StateID.StateLeftStepRun,
        Tails.StateID.StateRightStep,
        Tails.StateID.StateRightStepRun,
        Tails.StateID.StateQuickStepLeft,
        Tails.StateID.StateQuickStepRight,
        Tails.StateID.StateQuickStepRoot,
    };

    static List<string> quickstepVoices = new List<string>{"sa1001", "sa1003", "sa1007", "sa1024", "sa1034", "sa1038"};
    static List<string> guardedflipVoices = new List<string>{"sa1025", "sa1035"};
    static List<string> auratrainVoices = new List<string>{"ta1112", "ta1100"};

    static Random random = new Random();

    // State flags
    static bool isTakeDamageMisc = false;   
    static bool isSomersaultLand = false;
    static bool isGrindStep = false;
    static bool isSpinJump = false;
    static bool isDoubleJumpGrunt = false;
    static bool isSquatGrunt = false;
    static bool isDeath = false;
    static bool isDeathLava = false;
    static bool isDashRamp = false;
    static bool isTrickFinish = false;
    static bool isBreatheGrunt = false;
    static bool isCycloneStart = false;
    static bool isHangPole = false;
    static bool isQuickStep = false;
    static bool isGaurdBlock = false;
    static bool isAuraTrain = false;

    static bool? qolCheckCache = null;

//
{
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;
    
    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    bool isUnderwater = Player.Status.IsUnderwater();

    // Grind Step
    if (currentState == Tails.StateID.StateGrindStep)
    {
        if (!isGrindStep)
        {
            Player.Sound.PlaySound("sn_triangle_jump");
            Lua.Call("PlayVoice", "sa1007");
            isGrindStep = true;
        }
    }
    else
        isGrindStep = false;

    // Damage (misc)
    if (currentState == Tails.StateID.StateGrindDamage ||
        currentState == Tails.StateID.StateGrindDamageAir ||
        currentState == Tails.StateID.StateDivingDamage ||
        currentState == Tails.StateID.StateDivingSpecialDamage)
    {
        if (!isTakeDamageMisc)
        {
            Player.Sound.PlaySound("sn_damage");
            Lua.Call("PlayVoice", "sa1026");
            isTakeDamageMisc = true;
        }
    }
    else
        isTakeDamageMisc = false;

    // Somersault Landing
    if (currentState == Tails.StateID.StateSpringJumpHeadLand)
    {
        if (!isSomersaultLand)
        {
            Player.Sound.PlaySound("sn_bump_jump_roll");
            Lua.Call("PlayVoice", "sa1036");
            isSomersaultLand = true;
        }
    }
    else
        isSomersaultLand = false;

    // Spin Jump
    if (currentState == Tails.StateID.StateJump)
    {
        if (!isSpinJump)
        {
            Lua.Call("PlayVoice", "sa1001");
            isSpinJump = true;
        }
    }
    else
        isSpinJump = false;

    // Double Jump
    if (currentState == Tails.StateID.StateDoubleJump)
    {
        if (!isDoubleJumpGrunt)
        {
            Lua.Call("PlayVoice", "sa1007");
            isDoubleJumpGrunt = true;
        }
    }
    else
        isDoubleJumpGrunt = false;

    // Squat
    if (currentState == Tails.StateID.StateSquat)
    {
        if (!isSquatGrunt)
        {
            Player.Sound.PlaySound("sn_climb_jump");
            Lua.Call("PlayVoice", "ta1100");
            isSquatGrunt = true;
        }
    }
    else
        isSquatGrunt = false;

    // Death
    if (currentState == Tails.StateID.StateDead)
    {
        if (!isDeath)
        {
            Lua.Call("PlayVoice", "sa1027");
            isDeath = true;
        }
    }
    else
        isDeath = false;

    // Lava Death
    if (currentState == Tails.StateID.StateLavaDead)
    {
        if (!isDeathLava)
        {
            Lua.Call("PlayVoice", "sa1028");
            isDeathLava = true;
        }
    }
    else
        isDeathLava = false;

    // Trick Finish
    if (currentState == Tails.StateID.StateRecoveryJump)
    {
        if (!isTrickFinish)
        {
            Player.Sound.PlaySound("sn_climb_balance_ok");
            Lua.Call("PlayVoice", "ta1110");
            isTrickFinish = true;
        }
    }
    else
        isTrickFinish = false;

    // Breathe
    if (isUnderwater)
        isBreatheGrunt = false;
    else if (!isBreatheGrunt)
    {
        Lua.Call("PlayVoice", "sa1033");
        isBreatheGrunt = true;
    }

    // Dash Ramp
    if (currentState == Tails.StateID.StateJumpBoardLaunch)
    {
        if (!isDashRamp)
        {
            Player.Sound.PlaySound("obj_testtone");
            isDashRamp = true;
        }
    }
    else
        isDashRamp = false;

    // Cyclone Start
    if (currentState == Tails.StateID.StateCycloneAppear)
    {
        if (!isCycloneStart)
        {
            Lua.Call("PlayVoice", "ta1110");
            Player.Sound.PlaySound("sn_triangle_jump");
            Player.Sound.PlaySound("sn_chaosemerald_guard");
            isCycloneStart = true;
        }
    }
    else
        isCycloneStart = false;

    // Hang Pole
    if (currentState == Tails.StateID.StateHangPole)
    {
        if (!isHangPole)
        {
            Player.Sound.PlaySound("sn_catch");
            isHangPole = true;
        }
    }
    else
        isHangPole = false;

    // Quick Step
    if (QuickStepStates.Contains(currentState))
    {
        if (!isQuickStep)
        {
            Lua.Call("PlayVoice", quickstepVoices[random.Next(quickstepVoices.Count)]);
            isQuickStep = true;
        }
    }
    else
        isQuickStep = false;

    // Guard Block
    if (currentState == Tails.StateID.StateGuardedFlipBack)
    {
        if (!isGaurdBlock)
        {
            Lua.Call("PlayVoice", guardedflipVoices[random.Next(guardedflipVoices.Count)]);
            isGaurdBlock = true;
        }
    }
    else
        isGaurdBlock = false;

    // Aura Train
    if (currentState == Tails.StateID.StateAuraTrain)
    {
        if (!isAuraTrain)
        {
            Lua.Call("PlayVoice", auratrainVoices[random.Next(auratrainVoices.Count)]);
            isAuraTrain = true;
        }
    }
    else
        isAuraTrain = false;
}

Code "Extra Sounds (Knuckles the Echidna)" by "Batman Sonic & SuperNova124"
//
    #lib "Player"
    #lib "Knuckles"
    #lib "Lua"
    #lib "HMM"
    
    #load "System.Numerics.dll"

    using System.Numerics;
    using System.Collections.Generic;

    // Static lists
    static List<Knuckles.StateID> QuickStepStates = new List<Knuckles.StateID>
    {
        Knuckles.StateID.StateLeftStep,
        Knuckles.StateID.StateLeftStepRun,
        Knuckles.StateID.StateRightStep,
        Knuckles.StateID.StateRightStepRun,
        Knuckles.StateID.StateQuickStepLeft,
        Knuckles.StateID.StateQuickStepRight,
        Knuckles.StateID.StateQuickStepRoot,
    };

    static List<string> quickstepVoices = new List<string>{"ka1100", "sa1003", "sa1007", "sa1034", "sa1036", "sa1038"};
    static List<string> guardedflipVoices = new List<string>{"ka1200", "sa1011", "sa1029"};
    static List<string> auratrainVoices = new List<string>{"ka1112", "ka1100"};

    static Random random = new Random();

    // State flags
    static bool isPunchOne = false;
    static bool isPunchTwo = false;
    static bool isPunchThree = false;
    static bool isHeatKnuckle = false;
    static bool isHeatKnuckleFollow = false;
    static bool isHeatKnuckleAfter = false;
    static bool isTakeDamageMisc = false;   
    static bool isSomersaultLand = false;
    static bool isGrindStep = false;
    static bool isSpinJump = false;
    static bool isDoubleJumpGrunt = false;
    static bool isStompAttackLand = false;
    static bool isStompAttack = false;
    static bool isSquatGrunt = false;
    static bool isDeath = false;
    static bool isDeathLava = false;
    static bool isDashRamp = false;
    static bool isTrickFinish = false;
    static bool isBreatheGrunt = false;
    static bool isDrillStart = false;
    static bool isDrillJump = false;
    static bool isCyknuckle = false;
    static bool isCyknuckleGround = false;
    static bool isCyknuckleWall = false;
    static bool isHangPole = false;
    static bool isQuickStep = false;
    static bool isGaurdBlock = false;
    static bool isAuraTrain = false;

    static bool? qolCheckCache = null;

//
{
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;
    
    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    bool isUnderwater = Player.Status.IsUnderwater();
    bool isBoostPressed = Player.Input.IsPressed(Player.InputActionType.PlayerBoost);

    // Punch 1
    if (currentState == Knuckles.StateID.KnucklesStatePunch1)
    {
        if (!isPunchOne)
        {
            Lua.Call("PlayVoice", "sa1034");
            isPunchOne = true;
        }
    }
    else
        isPunchOne = false;

    // Punch 2
    if (currentState == Knuckles.StateID.KnucklesStatePunch2)
    {
        if (!isPunchTwo)
        {
            Lua.Call("PlayVoice", "sa1024");
            isPunchTwo = true;
        }
    }
    else
        isPunchTwo = false;

    // Punch 3
    if (currentState == Knuckles.StateID.KnucklesStateUppercut)
    {
        if (!isPunchThree)
        {
            Lua.Call("PlayVoice", "sa1010");
            isPunchThree = true;
        }
    }
    else
        isPunchThree = false;

    // Heat Knuckle Charge
    if (currentState == Knuckles.StateID.StateMaximumHeatKnuckle)
    {
        if (!isHeatKnuckle)
        {
            Lua.Call("PlayVoice", "ka1202");
            Player.Sound.PlaySound("_sn_stomping_start");
            isHeatKnuckle = true;
        }
    }
    else
        isHeatKnuckle = false;

    // Heat Knuckle Attack
    if (currentState == Knuckles.StateID.StateMaximumHeatKnuckleFollow)
    {
        if (!isHeatKnuckleFollow)
        {
            Player.Sound.PlaySound("sn_homing");
            isHeatKnuckleFollow = true;
        }
    }
    else
        isHeatKnuckleFollow = false;

    // Heat Knuckle Bounce
    if (currentState == Knuckles.StateID.StateMaximumHeatKnuckleBounce)
    {
        if (!isHeatKnuckleAfter)
        {
            Lua.Call("PlayVoice", "sa1034");
            Player.Sound.PlaySound("sn_lightdash");
            isHeatKnuckleAfter = true;
        }
    }
    else
        isHeatKnuckleAfter = false;

    // Grind Step
    if (currentState == Knuckles.StateID.StateGrindStep)
    {
        if (!isGrindStep)
        {
            Player.Sound.PlaySound("sn_triangle_jump");
            Lua.Call("PlayVoice", "sa1007");
            isGrindStep = true;
        }
    }
    else
        isGrindStep = false;

    // Damage (misc)
    if (currentState == Knuckles.StateID.StateGrindDamage ||
        currentState == Knuckles.StateID.StateGrindDamageAir ||
        currentState == Knuckles.StateID.StateDivingDamage ||
        currentState == Knuckles.StateID.StateDivingSpecialDamage)
    {
        if (!isTakeDamageMisc)
        {
            Player.Sound.PlaySound("sn_damage");
            Lua.Call("PlayVoice", "sa1026");
            isTakeDamageMisc = true;
        }
    }
    else
        isTakeDamageMisc = false;

    // Somersault Landing
    if (currentState == Knuckles.StateID.StateSpringJumpHeadLand)
    {
        if (!isSomersaultLand)
        {
            Player.Sound.PlaySound("sn_bump_jump_roll");
            Lua.Call("PlayVoice", "sa1034");
            isSomersaultLand = true;
        }
    }
    else
        isSomersaultLand = false;

    // Spin Jump
    if (currentState == Knuckles.StateID.StateJump ||
        currentState == Knuckles.StateID.StateBaseJump ||
        currentState == Knuckles.StateID.StateTreeJump)
    {
        if (!isSpinJump)
        {
            Player.Sound.PlaySound("sn_windmill_kick");
            Lua.Call("PlayVoice", "sa1003");
            isSpinJump = true;
        }
    }
    else
        isSpinJump = false;

    // Double Jump
    if (currentState == Knuckles.StateID.StateDoubleJump)
    {
        if (!isDoubleJumpGrunt)
        {
            Lua.Call("PlayVoice", "sa1007");
            isDoubleJumpGrunt = true;
        }
    }
    else
        isDoubleJumpGrunt = false;

    // Stomp Attack
    if (currentState == Knuckles.StateID.KnucklesStateStompingDown)
    {
        if (!isStompAttack)
        {
            Lua.Call("PlayVoice", "ka1202");
            isStompAttack = true;
        }
    }
    else
        isStompAttack = false;

    // Stomp Attack Land
    if (currentState == Knuckles.StateID.KnucklesStateStompingLand)
    {
        if (!isStompAttackLand)
        {
            Lua.Call("PlayVoice", "ka1110");
            isStompAttackLand = true;
        }
    }
    else
        isStompAttackLand = false;

    // Squat
    if (currentState == Knuckles.StateID.StateSquat)
    {
        if (!isSquatGrunt)
        {
            Player.Sound.PlaySound("sn_climb_jump");
            Lua.Call("PlayVoice", "sa1001");
            isSquatGrunt = true;
        }
    }
    else
        isSquatGrunt = false;

    // Death
    if (currentState == Knuckles.StateID.StateDead)
    {
        if (!isDeath)
        {
            Lua.Call("PlayVoice", "sa1027");
            isDeath = true;
        }
    }
    else
        isDeath = false;

    // Lava Death
    if (currentState == Knuckles.StateID.StateLavaDead)
    {
        if (!isDeathLava)
        {
            Lua.Call("PlayVoice", "sa1028");
            isDeathLava = true;
        }
    }
    else
        isDeathLava = false;

    // Trick Finish
    if (currentState == Knuckles.StateID.StateRecoveryJump)
    {
        if (!isTrickFinish)
        {
            Player.Sound.PlaySound("sn_climb_balance_ok");
            Lua.Call("PlayVoice", "ka1110");
            isTrickFinish = true;
        }
    }
    else
        isTrickFinish = false;

    // Breathe
    if (isUnderwater)
        isBreatheGrunt = false;
    else if (!isBreatheGrunt)
    {
        Lua.Call("PlayVoice", "sa1033");
        isBreatheGrunt = true;
    }

    // Dash Ramp
    if (currentState == Knuckles.StateID.StateJumpBoardLaunch)
    {
        if (!isDashRamp)
        {
            Player.Sound.PlaySound("obj_testtone");
            isDashRamp = true;
        }
    }
    else
        isDashRamp = false;

    // Cyknuckle Ground
    if (currentState == Knuckles.StateID.StateCyKnuckle)
    {
        if (!isCyknuckleGround)
        {
            Lua.Call("PlayVoice", "sa1024");
            isCyknuckleGround = true;
        }
    }
    else
        isCyknuckleGround = false;

    // Cyknuckle Wall
    if (currentState == Knuckles.StateID.StateCyKnuckleWall)
    {
        if (!isCyknuckleWall)
        {
            Lua.Call("PlayVoice", "sa1010");
            isCyknuckleWall = true;
        }
    }
    else
        isCyknuckleWall = false;

    // Cyknuckle Pre-Fall
    if (currentState == Knuckles.StateID.StateCyKnucklePreFall)
    {
        if (!isCyknuckle)
        {
            Player.Sound.PlaySound("sn_chaosemerald_guard");
            Player.Sound.PlaySound("sn_skateboard_jump");
            Lua.Call("PlayVoice", "ka1202");
            isCyknuckle = true;
        }
    }
    else
        isCyknuckle = false;

    // Drill Boost Start
    if ((currentState == Knuckles.StateID.KnucklesStateDrillBoost ||
         currentState == Knuckles.StateID.KnucklesStateDrillBoostAir) &&
        (isBoostPressed || currentState == Knuckles.StateID.KnucklesStateDrillBoostAir))
    {
        if (!isDrillStart)
        {
            Lua.Call("PlayVoice", "ka1110");
            Player.Sound.PlaySound("_sn_stomping_start");
            isDrillStart = true;
        }
    }
    else
        isDrillStart = false;

    // Drill Jump
    if (currentState == Knuckles.StateID.KnucklesStateDrillBoostJump)
    {
        if (!isDrillJump)
        {
            Player.Sound.PlaySound("sn_triangle_jump");
            isDrillJump = true;
        }
    }
    else
        isDrillJump = false;

    // Hang Pole
    if (currentState == Knuckles.StateID.StateHangPole)
    {
        if (!isHangPole)
        {
            Player.Sound.PlaySound("sn_catch");
            isHangPole = true;
        }
    }
    else
        isHangPole = false;

    // Quick Step
    if (QuickStepStates.Contains(currentState))
    {
        if (!isQuickStep)
        {
            Lua.Call("PlayVoice", quickstepVoices[random.Next(quickstepVoices.Count)]);
            isQuickStep = true;
        }
    }
    else
        isQuickStep = false;

    // Guard Block
    if (currentState == Knuckles.StateID.StateGuardedFlipBack)
    {
        if (!isGaurdBlock)
        {
            Lua.Call("PlayVoice", guardedflipVoices[random.Next(guardedflipVoices.Count)]);
            isGaurdBlock = true;
        }
    }
    else
        isGaurdBlock = false;

    // Aura Train
    if (currentState == Knuckles.StateID.StateAuraTrain)
    {
        if (!isAuraTrain)
        {
            Lua.Call("PlayVoice", auratrainVoices[random.Next(auratrainVoices.Count)]);
            isAuraTrain = true;
        }
    }
    else
        isAuraTrain = false;
}

