        {
            case 1:
                soundFileName = "SFX_CameraGaze.wav";
                break;
            case 2:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["cameragazeVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

if (conRestoreCameraGaze == 2)
{
    // Disable sounds
}
else if (Player.Status.IsLockOnCursorVisible() && Player.Input.IsPressed(Player.InputActionType.CameraGaze) && !IS_WORLD_FLAG(IsCyberSpace))
{
    if (Lua.GetState() != 0 && !soundPlayed)
    {
        sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customUI", soundFileName)));
        sound.Volume = volumeLevel / 100;
        sound.Position = new TimeSpan(0);
        sound.Play();
        soundPlayed = true;
    }

    if (isPaused && Lua.GetState() != 0)
    {
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed && !sound.HasAudio)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

if (!Player.Input.IsPressed(Player.InputActionType.CameraGaze))
{
    soundPlayed = false;
}

if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Drowning Jingle" by "Batman Sonic & SuperNova124"
//

#lib "Player"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"

using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float drownjingleTime = 0.0f;
static float musicTime = 8.0f;
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool musicPlayed = false;
static bool isPaused = false;
static string currentModDirectory;
static int conDrowningJingle = 0;
static string soundFileName = "";
//
{
    if (!initialized)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");

        if (mods.Count == 1)
        {
            currentModDirectory = mods[0].Path;
            string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conDrowningJingle = INI.Parse<int>(ini["Main"]["DrowningJingle"], conDrowningJingle);

            // Change the sound file based on conDrowningJingle
            switch (conDrowningJingle)
            {
                case 1:
                    soundFileName = "BGM_DrowningFrontiers.wav";
                    break;
                case 2:
                    soundFileName = "BGM_DrowningDreamcast.wav";
                    break;
                case 3:
                    soundFileName = "BGM_DrowningMania.wav";
                    break;
                case 4:
                    soundFileName = "BGM_DrowningCD.wav";
                    break;
                case 5:
                    soundFileName = "BGM_DrowningGenesis.wav";
                    break;
                case 6:
                    // Disable sounds
                    return; // Exit the function
                default:
                    // Handle other cases if needed
                    break;
            }

            volumeLevel = INI.Parse<float>(ini["Main"]["drowningVolume"], volumeLevel);
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
            return;
        }

        initialized = true;
    }

    if (Player.Status.IsUnderwater())
    {
        if (Lua.GetState() != 0)
        {
            drownjingleTime += Time.GetDeltaTime();
        }
    }
    else if (!Player.Status.IsUnderwater())
    {
        drownjingleTime = 0.0f;
        sound.Stop();
        musicPlayed = false;
    }

    if (drownjingleTime >= musicTime)
    {
        if (conDrowningJingle != 4 || conDrowningJingle != 6) // Ensure bgm_jingle_drown does not play if conDrowningJingle is 4 or 6
        {
            Player.Sound.PlaySound("bgm_jingle_drown"); // stops current bgm, for some reason
        }

        if (!musicPlayed)
        {
            sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customUI", soundFileName)));
            sound.Volume = volumeLevel / 100;
            sound.Position = new TimeSpan(0);
            sound.Play();
            musicPlayed = true;
        }
        if (isPaused && Lua.GetState() != 0)
        {
            sound.Play();
            isPaused = false;
        }
    }

    if (Lua.GetState() == 0 && musicPlayed)
    {
        if (!isPaused)
        {
            sound.Pause();
            isPaused = true;
        }
    }
}

Code "Drowning Alert Jingle" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conDrowningAlertJingle = 0;
static string soundFileName = "";
static Random random = new Random(); // Random number generator

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conDrowningAlertJingle = INI.Parse<int>(ini["Main"]["DrowningAlertJingle"], conDrowningAlertJingle);

        // Change the sound file based on conDrowningAlertJingle
        switch (conDrowningAlertJingle)
        {
            case 1:
                soundFileName = "SFX_DrowningCounts.wav";
                break;
            case 2:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["drowningalarmVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

bool isUnderwater = Player.Status.IsUnderwater();

if (isUnderwater)
{
    if (conDrowningAlertJingle != 2 && !soundPlayed)
    {
        if (Lua.GetState() != 0)
        {
            // Check probability of 50% (5/10)
            if (random.NextDouble() <= 0.5)
            {
                sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customUI", soundFileName)));
                sound.Volume = volumeLevel / 100;
                sound.Position = new TimeSpan(0);
                sound.Play();
                soundPlayed = true;
            }
        }
    }

    if (isPaused && Lua.GetState() != 0)
    {
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

