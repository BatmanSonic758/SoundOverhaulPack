static List<string> tailsBoostVoices = new List<string>{"sa1005", "sa1024", "sa1038", "ta1112", "ta1110"};
static List<string> knucklesBoostVoices = new List<string>{"ka1112", "ka1100", "sa1010"};
static List<string> amyBoostVoices = new List<string>{"sa1024", "sa1038", "aa1112", "aa1110"};

// Static state lists
static List<Tails.StateID> CycloneStates = new List<Tails.StateID>
{
    Tails.StateID.StateCycloneBoostRoot,
    Tails.StateID.StateAirBoostCyclone,
    Tails.StateID.StateCycloneAppear,
    Tails.StateID.StateCycloneBoost,
    Tails.StateID.StateLeftStepCyclone,
    Tails.StateID.StateRightStepCyclone
};

static List<Knuckles.StateID> DrillStates = new List<Knuckles.StateID>
{
    Knuckles.StateID.KnucklesStateDrillBoostRoot,
    Knuckles.StateID.KnucklesStateDrillBoost,
    Knuckles.StateID.KnucklesStateDrillBoostJump,
    Knuckles.StateID.KnucklesStateDrillBoostFall,
    Knuckles.StateID.KnucklesStateDrillBoostStep,
    Knuckles.StateID.KnucklesStateDrillBoostAir
};

static List<Amy.StateID> BikeStates = new List<Amy.StateID>
{
    Amy.StateID.AmyStateTarotBoostAir,
    Amy.StateID.AmyStateTarotBikeRoot,
    Amy.StateID.AmyStateTarotBuildRoot,
    Amy.StateID.AmyStateTarotBuild,
    Amy.StateID.AmyStateTarotBuildAir,
    Amy.StateID.AmyStateTarotBuildFall,
    Amy.StateID.AmyStateTarotBoostRoot,
    Amy.StateID.AmyStateTarotBoost,
    Amy.StateID.AmyStateTarotBoostTurn,
    Amy.StateID.AmyStateTarotBoostStep,
    Amy.StateID.AmyStateTarotBoostJump,
    Amy.StateID.AmyStateTarotBoostFall,
    Amy.StateID.AmyStateTarotDrift
};

static Random random = new Random();
static bool isBoostTalk = false;

// Config caching
static bool? configInitCache = null;
static int conBoostGrunt = 0;

{
    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);
            conBoostGrunt = INI.Parse<int>(ini["Main"]["BoostGrunt"], conBoostGrunt);
        }
        configInitCache = true;
    }

    // Exit early if sounds disabled
    if (conBoostGrunt == 3)
        return;

    // Exit early if feature disabled
    if (conBoostGrunt != 1 && conBoostGrunt != 2)
        return;

    // Cache boost flag
    bool isBoost = IS_STATE_FLAG(IsBoost);
    var playerType = Player.GetPlayerType();

    // Determine if we should play sound based on character
    bool shouldPlaySound = false;
    List<string> voiceList = null;

    switch (playerType)
    {
        case Player.PlayerType.Sonic:
            {
                var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
                bool isSuperSonic = BlackboardStatus.IsSuper();
                bool isInSpinBoost = currentState == Sonic.StateID.StateSpinBoost;

                // Regular boost (not super, not spin boost)
                if (isBoost && !isSuperSonic && !isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = sonicBoostVoices;
                }
                // Spin boost (if config allows)
                else if (conBoostGrunt == 2 && isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = sonicBoostVoicesSpin;
                }
            }
            break;

        case Player.PlayerType.Tails:
            {
                var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
                bool isInCyclone = CycloneStates.Contains(currentState);
                bool isInSpinBoost = currentState == Tails.StateID.StateSpinBoost;

                // Regular boost (not cyclone, not spin boost)
                if (isBoost && !isInCyclone && !isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = tailsBoostVoices;
                }
                // Spin boost (if config allows)
                else if (conBoostGrunt == 2 && isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = tailsBoostVoices;
                }
            }
            break;

        case Player.PlayerType.Knuckles:
            {
                var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
                bool isInDrill = DrillStates.Contains(currentState);
                bool isInSpinBoost = currentState == Knuckles.StateID.StateSpinBoost;

                // Regular boost (not drill, not spin boost)
                if (isBoost && !isInDrill && !isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = knucklesBoostVoices;
                }
                // Spin boost (if config allows)
                else if (conBoostGrunt == 2 && isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = knucklesBoostVoices;
                }
            }
            break;

        case Player.PlayerType.Amy:
            {
                var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
                bool isInBike = BikeStates.Contains(currentState);
                bool isInSpinBoost = currentState == Amy.StateID.StateSpinBoost;

                // Regular boost (not bike, not spin boost)
                if (isBoost && !isInBike && !isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = amyBoostVoices;
                }
                // Spin boost (if config allows)
                else if (conBoostGrunt == 2 && isInSpinBoost)
                {
                    shouldPlaySound = true;
                    voiceList = amyBoostVoices;
                }
            }
            break;
    }

    // Play sound if conditions met
    if (shouldPlaySound)
    {
        if (!isBoostTalk)
        {
            Lua.Call("PlayVoice", voiceList[random.Next(voiceList.Count)]);
            isBoostTalk = true;
        }
    }
    else
    {
        isBoostTalk = false;
    }
}

Code "Spin States Grunt (All Characters)" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "Lua"

using System.Collections.Generic;

// Static voice lists per character
static List<string> sonicSpinVoices = new List<string>{"sa1039", "sa1040", "sa1041", "sa1051", "sa1008"};
static List<string> tailsSpinVoices = new List<string>{"sa1005", "sa1024", "sa1038", "ta1112", "ta1110"};
static List<string> knucklesSpinVoices = new List<string>{"ka1112", "ka1100", "sa1010"};
static List<string> amySpinVoices = new List<string>{"sa1024", "sa1038", "aa1112", "aa1110"};

// Spin states are shared across all characters, so read them through Sonic.StateID
static List<Sonic.StateID> SpinStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin
};

static Random random = new Random();
static bool isSpinTalk = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    bool isInSpinState = SpinStates.Contains(currentState);

    if (isInSpinState)
    {
        if (!isSpinTalk)
        {
            List<string> voiceList = null;

            switch (Player.GetPlayerType())
            {
                case Player.PlayerType.Sonic:
                    voiceList = sonicSpinVoices;
                    break;
                case Player.PlayerType.Tails:
                    voiceList = tailsSpinVoices;
                    break;
                case Player.PlayerType.Knuckles:
                    voiceList = knucklesSpinVoices;
                    break;
                case Player.PlayerType.Amy:
                    voiceList = amySpinVoices;
                    break;
            }

            if (voiceList != null)
            {
                Lua.Call("PlayVoice", voiceList[random.Next(voiceList.Count)]);
            }

            isSpinTalk = true;
        }
    }
    else
    {
        isSpinTalk = false;
    }
}

Code "Flying Sound in Stomping" by "Batman Sonic & SuperNova124"
// Plays Tails' flying sound during stomping animation

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Tails"
#lib "HMM"

#import "States"

#load "System.Numerics.dll"

using System.Numerics;

// State tracking
static bool isTailSpin = false;
static int soundHandle = 0;

// Cache QoL check result
static bool? qolCheckCache = null;

//
{
    // Check QoL only once
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    // Early exit if not Tails
    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    // Cache state checks
    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

    // Entering stomping state
    if (currentState == Tails.StateID.TailsStateStompingDown &&
        previousState != Tails.StateID.TailsStateStompingDown)
    {
        if (!isTailSpin)
        {
            soundHandle = Player.Sound.PlaySound("ta_fly_loop");
            isTailSpin = true;
        }
    }
    // Exiting stomping state
    else if (currentState != Tails.StateID.TailsStateStompingDown &&
             previousState == Tails.StateID.TailsStateStompingDown)
    {
        if (isTailSpin)
        {
            fixed (int* pSoundHandle = &soundHandle)
            {
                Player.Sound.StopSound(pSoundHandle);
            }
            soundHandle = 0;
            isTailSpin = false;
        }
    }
}

Code "Boost Sound Fixes (Tails & Amy)" by "Batman Sonic & SuperNova124"
// Fixes Tails and Amy's boost sounds being missing during:
// 1. Spin Dash Boost
// 2. Max Ring Grind Boost

#include "Reflection" noemit

#lib "Player"
#lib "Tails"
#lib "Amy"
#lib "BlackboardItem"
#lib "HMM"

#load "System.Numerics.dll"

using System.Numerics;

// Separate flags for each fix
static bool isSpinBoostFixTails = false;
static bool isSpinBoostFixAmy = false;
static bool isGrindBoostFixTails = false;
static bool isGrindBoostFixAmy = false;

// Cache QoL check result
static bool? qolCheckCache = null;

//
{
    // Check QoL only once
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    // Cache boost flag once
    bool isBoost = IS_STATE_FLAG(IsBoost);
    
    // Cache player type once
    var playerType = Player.GetPlayerType();

    // Handle Tails fixes
    if (playerType == Player.PlayerType.Tails)
    {
        // Cache state checks
        var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
        var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

        // ===== FIX 1: SPIN DASH BOOST SOUND =====
        
        // Entering spin boost with boost active
        if (currentState == Tails.StateID.StateSpinBoost &&
            previousState != Tails.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isSpinBoostFixTails)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isSpinBoostFixTails = true;
            }
        }
        else
        {
            isSpinBoostFixTails = false;
        }

        // Exiting spin boost
        if (currentState != Tails.StateID.StateSpinBoost &&
            previousState == Tails.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            Player.Sound.StopSound(&soundBoostFix);
        }

        // ===== FIX 2: MAX RING GRIND BOOST SOUND =====
        
        var pBlackboardItem = BlackboardItem.Get();
        if (pBlackboardItem != null)
        {
            int maxrings = pBlackboardItem->RingCapacity;
            int rings = pBlackboardItem->RingCount;

            // Entering grind with max rings and boost active
            if (currentState == Tails.StateID.StateGrind &&
                previousState != Tails.StateID.StateGrind &&
                isBoost && rings == maxrings)
            {
                if (!isGrindBoostFixTails)
                {
                    Player.Sound.PlaySound("sn_boost_run");
                    isGrindBoostFixTails = true;
                }
            }
            else
            {
                isGrindBoostFixTails = false;
            }

            // Exiting grind with max rings
            if (currentState != Tails.StateID.StateGrind &&
                previousState == Tails.StateID.StateGrind &&
                !isBoost && rings == maxrings)
            {
                int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
    // Handle Amy fixes
    else if (playerType == Player.PlayerType.Amy)
    {
        // Cache state checks
        var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
        var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

        // ===== FIX 1: SPIN DASH BOOST SOUND =====
        
        // Entering spin boost with boost active
        if (currentState == Amy.StateID.StateSpinBoost &&
            previousState != Amy.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isSpinBoostFixAmy)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isSpinBoostFixAmy = true;
            }
        }
        else
        {
            isSpinBoostFixAmy = false;
        }

        // Exiting spin boost
        if (currentState != Amy.StateID.StateSpinBoost &&
            previousState == Amy.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            Player.Sound.StopSound(&soundBoostFix);
        }

        // ===== FIX 2: MAX RING GRIND BOOST SOUND =====
        
        var pBlackboardItem = BlackboardItem.Get();
        if (pBlackboardItem != null)
        {
            int maxrings = pBlackboardItem->RingCapacity;
            int rings = pBlackboardItem->RingCount;

            // Entering grind with max rings and boost active
            if (currentState == Amy.StateID.StateGrind &&
                previousState != Amy.StateID.StateGrind &&
                isBoost && rings == maxrings)
            {
                if (!isGrindBoostFixAmy)
                {
                    Player.Sound.PlaySound("sn_boost_run");
                    isGrindBoostFixAmy = true;
                }
            }
            else
            {
                isGrindBoostFixAmy = false;
            }

            // Exiting grind with max rings
            if (currentState != Amy.StateID.StateGrind &&
                previousState == Amy.StateID.StateGrind &&
                !isBoost && rings == maxrings)
            {
                int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
}

Code "Boost Sound for Sonic's Drift" by "Batman Sonic & SuperNova124"
// Adds a boost sound when pressing the Boost input during a Drift

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

static bool driftBoostActive = false;
static bool boostWasHeldLastFrame = false;
static int driftBoostHandle = -1;

// Configuration cache
static bool? configInitCache = null;
static int conSonicDriftBoost = 0;

// State tracking
static bool isSonicDriftBoost = false;

// Cache QoL check result
static bool? qolCheckCache = null;

//
{
    // Check QoL only once
    if (qolCheckCache == null)
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    
    if (qolCheckCache.Value)
        return;

    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conSonicDriftBoost = INI.Parse<int>(ini["Main"]["SonicDriftBoost"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
                return;
            }
        }
        else
        {
            configInitCache = false;
            return;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conSonicDriftBoost != 1)
        return;

    // Early exit if not Sonic
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState  = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isDrift     = currentState == Sonic.StateID.StateDrift;
    bool isBoostDown = Player.Input.IsDown(Player.InputActionType.PlayerBoost);

    // Detect entering drift
    bool justEnteredDrift =
        currentState == Sonic.StateID.StateDrift &&
        previousState != Sonic.StateID.StateDrift;

    // If we entered drift while boost was already held,
    // block sound until boost is released once
    if (justEnteredDrift && boostWasHeldLastFrame)
    {
        driftBoostActive = true; // Prevent playback
    }

    // Play only on fresh press during drift
    if (isDrift && isBoostDown && !boostWasHeldLastFrame && !driftBoostActive)
    {
        driftBoostHandle = Player.Sound.PlaySound("sn_boost_run");
        driftBoostActive = true;
    }

    // Stop when releasing boost or leaving drift
    if (driftBoostActive && (!isDrift || !isBoostDown))
    {
        int driftBoostHandle = Player.Sound.PlaySound("sn_boost_run");
		Player.Sound.StopSound(&driftBoostHandle);
        driftBoostActive = false;
    }

    // Update input memory
    boostWasHeldLastFrame = isBoostDown;
}

Code "Forces-like Jump Ball Sound" by "Batman Sonic & SuperNova124"
// Makes the spin sound play when each character curls into a ball, like in Sonic Forces

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Knuckles"
#lib "Amy"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;

// Configuration cache
static bool? configInitCache = null;
static int conForcesSpin = 0;
static bool? qolCheckCache = null;

// State tracking flags
static bool isJumpSpinAttack = false;
static bool isJumpSpinBounceAttack = false;
static bool isSpinDashJumpAmy = false;
static bool isBoostWallJump = false;

{
    // Check QoL mod once
    if (qolCheckCache == null)
    {
        qolCheckCache = HMM.GetModByID("frontiers.quality-of-life-additions") != null;
    }

    // Exit early if QoL is active
    if (qolCheckCache == true)
        return;

    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conForcesSpin = INI.Parse<int>(ini["Main"]["ForcesSpin"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
            }
        }
        else
        {
            configInitCache = false;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conForcesSpin != 1)
        return;

    // CRITICAL: Get player type ONCE and cache it
    var currentPlayerType = Player.GetPlayerType();

    // ========== SONIC, TAILS, KNUCKLES - Jump States ==========
    if (currentPlayerType == Player.PlayerType.Sonic || 
        currentPlayerType == Player.PlayerType.Tails || 
        currentPlayerType == Player.PlayerType.Knuckles)
    {
        // Get current state ONCE
        var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
        
        // Check which state we're in
        bool inJump = (currentState == Sonic.StateID.StateJump);
        bool inBounceJump = (currentState == Sonic.StateID.StateBounceJump);
        bool inBaseJump = (currentState == Sonic.StateID.StateBaseJump);

        // ===== REGULAR JUMP =====
        if (inJump)
        {
            if (!isJumpSpinAttack)
            {
                Player.Sound.PlaySound("sn_spin");
                isJumpSpinAttack = true;
            }
        }
        else if (isJumpSpinAttack)
        {
            // Exited jump - stop sound
            int soundHandle = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundHandle);
            isJumpSpinAttack = false;
        }

        // ===== BOUNCE JUMP =====
        if (inBounceJump)
        {
            if (!isJumpSpinBounceAttack)
            {
                Player.Sound.PlaySound("sn_spin");
                isJumpSpinBounceAttack = true;
            }
        }
        else if (isJumpSpinBounceAttack)
        {
            // Exited bounce jump - stop sound
            int soundHandle = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundHandle);
            isJumpSpinBounceAttack = false;
        }

        // ===== BASE JUMP (Wall Jump) =====
        if (inBaseJump)
        {
            if (!isBoostWallJump)
            {
                Player.Sound.PlaySound("sn_spin");
                isBoostWallJump = true;
            }
        }
        else if (isBoostWallJump)
        {
            // Exited base jump - stop sound
            int soundHandle = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundHandle);
            isBoostWallJump = false;
        }
    }
    // ========== AMY - Spin Dash Jump ==========
    else if (currentPlayerType == Player.PlayerType.Amy)
    {
        var amyCurrentState = Player.State.GetCurrentStateID<Amy.StateID>();
        var amyPreviousState = Player.State.GetPreviousStateID<Amy.StateID>();
        
        // Check if we're in jump from spin boost
        if (amyCurrentState == Amy.StateID.StateJump &&
            amyPreviousState == Amy.StateID.StateSpinBoost)
        {
            if (!isSpinDashJumpAmy)
            {
                Player.Sound.PlaySound("sn_spin");
                isSpinDashJumpAmy = true;
            }
        }
        // Exited jump - stop sound
        else if (isSpinDashJumpAmy && amyCurrentState != Amy.StateID.StateJump)
        {
            int soundHandle = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundHandle);
            isSpinDashJumpAmy = false;
        }
    }
}

Code "2006-styled Double Jump" by "Batman Sonic & SuperNova124"
// Adds an additional Double Jump sound for Amy, like in SONIC THE HEDGEHOG (2006)

#include "Reflection" noemit

#lib "Player"
#lib "Amy"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;

// Configuration cache
static bool? configInitCache = null;
static int conAmyDoubleJumpNEXT = 0;

// State tracking
static bool isNEXTDoubleJump = false;
static bool isPropellerJumpSoundPlayed = false;

{
    // Initialize config once
    if (configInitCache == null)
    {
        var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            if (System.IO.File.Exists(modConfigIniPath))
            {
                var ini = INI.Read(modConfigIniPath);
                conAmyDoubleJumpNEXT = INI.Parse<int>(ini["Main"]["AmyDoubleJumpNEXT"], 0);
                configInitCache = true;
            }
            else
            {
                configInitCache = false;
            }
        }
        else
        {
            configInitCache = false;
        }
    }

    // Exit early if initialization failed or feature disabled
    if (configInitCache == false || conAmyDoubleJumpNEXT == 4)
        return;

    // Early exit if not Amy
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    // Get state ONCE
    var currentState = Player.State.GetCurrentStateID<Amy.StateID>();

    // CRITICAL: No List.Contains! Direct comparison is much faster
    bool isDoubleJump = (currentState == Amy.StateID.StateDoubleJump);
    bool isPropellerJump = (currentState == Amy.StateID.StatePropellerJump);

    // Early exit if not in any relevant state
    if (!isDoubleJump && !isPropellerJump)
    {
        // Reset flags only if they were set
        if (isNEXTDoubleJump || isPropellerJumpSoundPlayed)
        {
            isNEXTDoubleJump = false;
            isPropellerJumpSoundPlayed = false;
        }
        return;
    }

    // ========== CONFIG OPTION 1: Double Jump Only ==========
    if (conAmyDoubleJumpNEXT == 1)
    {
        if (isDoubleJump && !isNEXTDoubleJump)
        {
            Player.Sound.PlaySound("sn_line_star");
            isNEXTDoubleJump = true;
        }
    }
    // ========== CONFIG OPTION 2: Propeller Jump Only ==========
    else if (conAmyDoubleJumpNEXT == 2)
    {
        if (isPropellerJump && !isPropellerJumpSoundPlayed)
        {
            Player.Sound.PlaySound("sn_line_star");
            isPropellerJumpSoundPlayed = true;
        }
    }
    // ========== CONFIG OPTION 3: Both Sounds ==========
    else if (conAmyDoubleJumpNEXT == 3)
    {
        if (isDoubleJump && !isNEXTDoubleJump)
        {
            Player.Sound.PlaySound("sn_line_star");
            isNEXTDoubleJump = true;
        }
        else if (isPropellerJump && !isPropellerJumpSoundPlayed)
        {
            Player.Sound.PlaySound("sn_line_star");
            isPropellerJumpSoundPlayed = true;
        }
    }
}

