Code "SLW-styled Spin Dash" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Tails"
#lib "Knuckles"
#lib "Amy"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conSpinDashImpact = 0;

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);
        
        conSpinDashImpact = INI.Parse<int>(ini["Main"]["SpinDashImpact"], conSpinDashImpact);

        volumeLevel = INI.Parse<float>(ini["Main"]["rollVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

List<Sonic.StateID> SpinDashStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateSpinBoost,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin,
	Sonic.StateID.StateDriftDash
};

if (conSpinDashImpact == 2)
{
    SpinDashStates.Add(Sonic.StateID.StateSliding);
}

if (conSpinDashImpact == 3)
{
    // Disable sounds
}

bool isSpinDash = SpinDashStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

if (conSpinDashImpact == 1 || conSpinDashImpact == 2)
{
    if (isSpinDash)
    {
        if (Lua.GetState() != 0 && !soundPlayed)
        {
            sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customAction", "SFX_SpinDashImpact.wav")));
            sound.Volume = volumeLevel / 100;
            sound.Position = new TimeSpan(0);
            sound.Play();
            soundPlayed = true;
        }

        if (isPaused && Lua.GetState() != 0)
        {
            sound.Play();
            isPaused = false;
        }
    }
    else
    {
        if (soundPlayed)
        {
            sound.Stop();
            soundPlayed = false;
        }
    }

    if (Lua.GetState() == 0 && soundPlayed)
    {
        if (!isPaused)
        {
            sound.Pause();
            isPaused = true;
        }
    }
}
else if (conSpinDashImpact == 3)
{
    if (soundPlayed)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

Code "Restore Quick Step" by "Batman Sonic & SuperNova124"
// Restore Quick Step sounds from previous titles.

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Sonic"
#lib "Tails"
#lib "Knuckles"
#lib "Amy"
#lib "BlackboardStatus"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System;
using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conQuickStep = 0;
static string soundFileName = "";

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);
		
        conQuickStep = INI.Parse<int>(ini["Main"]["QuickStep"], conQuickStep);

        // Change the sound file based on conQuickStep
        switch (conQuickStep)
        {
            case 1:
                soundFileName = "SFX_Quickstep_Unleashed.wav";
                break;
            case 2:
                soundFileName = "SFX_Quickstep_Colors.wav";
                break;
            case 3:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["quickstepVolume"], volumeLevel);
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

List<Sonic.StateID> QuickStepStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateLeftStep,
    Sonic.StateID.StateLeftStepRun,
    Sonic.StateID.StateRightStep,
    Sonic.StateID.StateRightStepRun,
    Sonic.StateID.StateQuickStepLeft,
    Sonic.StateID.StateQuickStepRight,
    Sonic.StateID.StateQuickStepRoot,
};

// Define list for Super Sonic quick step states
List<Sonic.StateID> SuperSonicQuickStepStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateAvoid,
    Sonic.StateID.StateAvoidLocal,
    Sonic.StateID.StateAvoidToTarget,
    Sonic.StateID.StateAvoidUpper
};

bool isQuickStep = QuickStepStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

bool isTailsQuickStep = Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.StateLeftStepCyclone ||
                        Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.StateRightStepCyclone;
						
bool isKnucklesQuickStep = Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.KnucklesStateDrillBoostStep;

bool isAmyQuickStep = Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateTarotBoostStep;

bool isSuperSonic = BlackboardStatus.IsSuper();

// Define bool variable for Super Sonic quick step
bool isQuickStepSuper = isSuperSonic && SuperSonicQuickStepStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

// Check if any character is in their respective quick step state or if Super Sonic is in a quick step state and play the sound accordingly
if (conQuickStep == 3)
{
    // Disable sounds
}
else if (isQuickStep || isTailsQuickStep || isKnucklesQuickStep || isAmyQuickStep || isQuickStepSuper)
{
    if (Lua.GetState() != 0 && !soundPlayed)
    {
        sound.Open(new Uri(Path.Combine(currentModDirectory, "raw_customAction", soundFileName)));
        sound.Volume = volumeLevel / 100;
        sound.Position = new TimeSpan(0);
        sound.Play();
        soundPlayed = true;
    }

    if (isPaused && Lua.GetState() != 0)
    {
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed && !sound.HasAudio)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

// Reset soundPlayed flag when no character is in a quick step state or when Super Sonic is not in a quick step state
if (!isQuickStep && !isTailsQuickStep && !isKnucklesQuickStep && !isAmyQuickStep && !isQuickStepSuper)
{
    soundPlayed = false;
}

if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Unleashed-Styled Sky Dive" by "Batman Sonic & SuperNova124"
//Adds the high quality Sky Dive sounds from Sonic Unleashed.

#include "Reflection" noemit
#lib "Player"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"
// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"
using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

// Check for sound overhaul pack
static bool initialized = false;
static string currentModDirectory;
static string diveSoundFileName = "SFX_SkyDiveNormal.wav";
static string divefastSoundFileName = "SFX_SkyDiveFast.wav";
static bool soundPlayed = false;
static bool isPaused = false;
static bool wasDivingNormal = false;
static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static int conSkyDiveUnleashed = 0;
static bool currentIsDiving = false;

// Add loop configuration
static Dictionary<string, (long start, long end)> loopConfig = new Dictionary<string, (long start, long end)>
{
    { "SFX_SkyDiveNormal.wav", (0, 190050) },
    { "SFX_SkyDiveFast.wav", (0, 80508) }
};

// Add MediaPlayer loop handling at initialization
sound.MediaEnded += (sender, e) => {
    var currentFile = currentIsDiving ? diveSoundFileName : divefastSoundFileName;
    if (loopConfig.ContainsKey(currentFile))
    {
        sound.Position = TimeSpan.FromTicks(loopConfig[currentFile].start);
        sound.Play();
    }
};

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");
    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        if (File.Exists(modConfigIniPath))
        {
            var ini = INI.Read(modConfigIniPath);
            conSkyDiveUnleashed = INI.Parse<int>(ini["Main"]["SkyDiveUnleashed"], conSkyDiveUnleashed);
            switch (conSkyDiveUnleashed)
            {
                case 1:
                    diveSoundFileName = "SFX_SkyDiveNormal.wav";
                    divefastSoundFileName = "SFX_SkyDiveFast.wav";
                    break;
                case 2:
                    // Disable sounds
                    return;
                default:
                    Console.WriteLine("Invalid sound option. Defaulting to option 1.");
                    break;
            }
            volumeLevel = INI.Parse<float>(ini["Main"]["skydiveVolume"], volumeLevel);
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] mod.ini not found.");
            return;
        }
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }
    initialized = true;
}

// Determine current state
bool isDiving = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDiving;
bool isDivingFast = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDivingFall;
currentIsDiving = isDiving;

// Handle sound playback based on state
if (Lua.GetState() != 0)
{
    if (isDiving || isDivingFast)
    {
        string soundPath = isDiving ? Path.Combine(currentModDirectory, "raw_customAction", diveSoundFileName)
                                    : Path.Combine(currentModDirectory, "raw_customAction", divefastSoundFileName);
        if (File.Exists(soundPath))
        {
            if (!soundPlayed || wasDivingNormal != isDiving)
            {
                sound.Open(new Uri(soundPath));
                sound.Volume = volumeLevel / 100;
                // Set initial position based on loop configuration
                string currentFile = isDiving ? diveSoundFileName : divefastSoundFileName;
                if (loopConfig.ContainsKey(currentFile))
                {
                    sound.Position = TimeSpan.FromTicks(loopConfig[currentFile].start);
                }
                sound.Play();
                soundPlayed = true;
            }
        }
        else
        {
            Console.WriteLine($"[Sound Overhaul Pack] Sound file not found at: {soundPath}");
        }
        wasDivingNormal = isDiving;
    }
    else
    {
        // Stop the sound if Sonic is not in a diving state
        if (soundPlayed)
        {
            sound.Stop();
            soundPlayed = false;
        }
    }
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}
else if (isPaused && Lua.GetState() != 0)
{
    sound.Play();
    isPaused = false;
}

Code "Custom Combat Sounds" by "Batman Sonic & SuperNova124"
// Adds unique punch and kick sounds for Sonic.

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

// Check for sound overhaul pack
static bool initialized = false;
static string currentModDirectory;
static string punchSoundFileName = "SFX_CombatPunch.wav";
static string kickSoundFileName = "SFX_CombatKick.wav";
static bool soundPlayed = false;
static bool isPaused = false;
static bool wasPunch = false;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static int conAcceleCombo = 0;

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");

        if (File.Exists(modConfigIniPath))
        {
            var ini = INI.Read(modConfigIniPath);
            conAcceleCombo = INI.Parse<int>(ini["Main"]["AcceleCombo"], conAcceleCombo);

            switch (conAcceleCombo)
            {
                case 1:
                    punchSoundFileName = "SFX_CombatPunch.wav";
                    kickSoundFileName = "SFX_CombatKick.wav";
                    break;
                case 2:
                    // Disable sounds
                    return;
                default:
                    Console.WriteLine("Invalid sound option. Defaulting to option 1.");
                    break;
            }

            volumeLevel = INI.Parse<float>(ini["Main"]["combatVolume"], volumeLevel);
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] mod.ini not found.");
            return;
        }
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

if (Player.GetPlayerType() != Player.PlayerType.Sonic)
    return;

// Determine current state
bool isAcceleCombo1 = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateAcceleCombo1;
bool isAcceleCombo2 = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateAcceleCombo2;

if (Lua.GetState() != 0 && (!soundPlayed || wasPunch != isAcceleCombo1))
{
    string soundPath;

    if (isAcceleCombo1)
    {
        soundPath = Path.Combine(currentModDirectory, "raw_customAction", punchSoundFileName);
    }
    else if (isAcceleCombo2)
    {
        soundPath = Path.Combine(currentModDirectory, "raw_customAction", kickSoundFileName);
    }
    else
    {
        return;
    }

    if (File.Exists(soundPath))
    {
        sound.Open(new Uri(soundPath));
        sound.Volume = volumeLevel / 100;
        sound.Position = new TimeSpan(0);
        sound.Play();
        soundPlayed = true;
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Combat sound file not found.");
    }

    wasPunch = isAcceleCombo1;
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}
else if (isPaused && Lua.GetState() != 0)
{
    sound.Play();
    isPaused = false;
}

Code "Heat Knuckle Charge" by "Batman Sonic & SuperNova124"
// Adds a Heat Knuckle charge sound and additional sounds for the aura and lock-on cursor

#include "Reflection" noemit

#lib "GameObject"
#lib "Player"
#lib "Knuckles"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"

// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer chargeSound = new MediaPlayer();
static MediaPlayer auraSound = new MediaPlayer();
static MediaPlayer lockOnSound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool chargeSoundPlayed = false;
static bool auraSoundPlayed = false;
static bool lockOnSoundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");

        if (File.Exists(modConfigIniPath))
        {
            var ini = INI.Read(modConfigIniPath);
            volumeLevel = INI.Parse<float>(ini["Main"]["heatknuckleVolume"], volumeLevel);
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] mod.ini not found.");
            return;
        }
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
    return;

var pGameObject = Player.Status.GetLockOnTarget();

if (pGameObject == null)
    return;

else if (GameObject.GetGOC(pGameObject, "GOCHealth") != null && Player.Input.IsDown(Player.InputActionType.PlayerAttack))
{
    if (Lua.GetState() != 0 && !chargeSoundPlayed)
    {
        string chargeSoundPath = Path.Combine(currentModDirectory, "raw_customAction", "SFX_HeatKnuckleCharge.wav");
        string auraSoundPath = Path.Combine(currentModDirectory, "raw_customAction", "SFX_HeatKnuckleAura.wav");
        string lockOnSoundPath = Path.Combine(currentModDirectory, "raw_customUI", "SFX_LockOnHeatKnuckle.wav");

        if (File.Exists(chargeSoundPath))
        {
            chargeSound.Open(new Uri(chargeSoundPath));
            chargeSound.Volume = volumeLevel / 100;
            chargeSound.Position = new TimeSpan(0);
            chargeSound.Play();
            chargeSoundPlayed = true;
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Heat Knuckle charge sound file not found.");
        }

        if (File.Exists(auraSoundPath))
        {
            auraSound.Open(new Uri(auraSoundPath));
            auraSound.Volume = volumeLevel / 100;
            auraSound.Position = new TimeSpan(0);
            auraSound.Play();
            auraSoundPlayed = true;
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Heat Knuckle aura sound file not found.");
        }

        if (File.Exists(lockOnSoundPath))
        {
            lockOnSound.Open(new Uri(lockOnSoundPath));
            lockOnSound.Volume = volumeLevel / 100;
            lockOnSound.Position = new TimeSpan(0);
            lockOnSound.Play();
            lockOnSoundPlayed = true;
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Heat Knuckle lock-on sound file not found.");
        }
    }

    if (isPaused && Lua.GetState() != 0)
    {
        chargeSound.Play();
        auraSound.Play();
        lockOnSound.Play();
        isPaused = false;
    }
}
else
{
    if (chargeSoundPlayed && Player.Input.IsReleased(Player.InputActionType.PlayerAttack))
    {
        chargeSound.Stop();
        auraSound.Stop();
        lockOnSound.Stop();
        chargeSoundPlayed = false;
        auraSoundPlayed = false;
        lockOnSoundPlayed = false;
    }
}

// Handle pause state
if (Lua.GetState() == 0 && chargeSoundPlayed)
{
    if (!isPaused)
    {
        chargeSound.Pause();
        auraSound.Pause();
        lockOnSound.Pause();
        isPaused = true;
    }
}

Code "Restore Zero Rings Warning" by "Batman Sonic & SuperNova124"
//Restores an unused warning sound that was meant to play when the player has zero rings.

#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;

#include "Reflection" noemit

#lib "Player"
#lib "BlackboardItem"

static bool hadRingsBefore = false;
static bool isRingWarning = false;
static int soundRingUp = 0;

static bool IsConfigInitialized = false;
static int conZeroRingWarning = 0;

if (!IsConfigInitialized)
{
    var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
    if (modsQuery.Count == 1)
    {
        string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conZeroRingWarning = INI.Parse<int>(ini["Main"]["ZeroRingWarning"], conZeroRingWarning);

        IsConfigInitialized = true;
    }
}

List<Sonic.StateID> DamageStates = new()
{
    Sonic.StateID.StateDamage,
    Sonic.StateID.StateDamageBlowOff,
	Sonic.StateID.StateDamageBlowOffHeavy,
    Sonic.StateID.StateDamageLava,
	Sonic.StateID.StateDamageQuake,
	Sonic.StateID.StateDamageRoot,
    Sonic.StateID.StateDamageRunning,
	Sonic.StateID.StateDamageTurnBack,
    Sonic.StateID.StateDivingDamage,
	Sonic.StateID.StateDivingSpecialDamage,
	Sonic.StateID.StateGrindDamage,
	Sonic.StateID.StateGrindDamageAir,
    Sonic.StateID.StateUpDownPoleDamage
};

    bool isDamage = DamageStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

// Check if the spin sound should be enabled
if (conZeroRingWarning == 1)
{
    //void RestoreZeroRingsWarning()
    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    int rings = pBlackboardItem->RingCount;

    if (rings == 0 && isDamage)
    {
        // Play the sound only when the player had rings before and it's not already playing
        if (hadRingsBefore && !isRingWarning)
        {
            soundRingUp = Player.Sound.PlaySound("sys_ring_zero_warning");
            isRingWarning = true;
        }
        // Reset the flag indicating whether the player had rings before
        hadRingsBefore = false;
    }
    else if (rings >= 1)
    {
        // Set the flag indicating that the player had rings before
        hadRingsBefore = true;

        // If the player has at least 1 ring, stop the sound
        if (isRingWarning)
        {
            int tempSoundRingUp = soundRingUp;
            Player.Sound.StopSound(&tempSoundRingUp);
            isRingWarning = false;
        }
    }
}
else if (conZeroRingWarning == 2)
{
    // Do nothing, i.e., let the sounds play
}

Code "Restore Zero Rings Warning (Tutorial)" by "Batman Sonic & SuperNova124"
//Restores an unused warning sound that was meant to play when the player has zero rings.

#lib "Player"
#lib "BlackboardItem"

#import "Postures"
#import "Services"

static bool isRingWarning = false;
static int soundRingUp = 0;

static bool IsConfigInitialized = false;
static int conZeroRingWarning = 0;

if (!IsConfigInitialized)
{
    var modsQuery = HMM.FindModsByName("Sound Overhaul Pack");
    if (modsQuery.Count == 1)
    {
        string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conZeroRingWarning = INI.Parse<int>(ini["Main"]["ZeroRingWarning"], conZeroRingWarning);

        IsConfigInitialized = true;
    }
}

// Check if the spin sound should be enabled
if (conZeroRingWarning == 1)
{
    if (LevelInfo.GetCurrentStageID() == "w1r02_1")
    {
        RestoreZeroRingsWarning();
    }
}

void RestoreZeroRingsWarning()
{
    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    int rings = pBlackboardItem->RingCount;

    if (conZeroRingWarning == 1) // Check if the configuration allows zero ring warning
    {
        if (rings == 0)
        {
            // Play the sound only when the player has 0 rings and it's not already playing
            if (!isRingWarning)
            {
                soundRingUp = Player.Sound.PlaySound("sys_ring_zero_warning");
                isRingWarning = true;
            }
        }
        else if (rings >= 1)
        {
            // If the player has at least 1 ring, stop the sound
            if (isRingWarning)
            {
                int tempSoundRingUp = soundRingUp;
                Player.Sound.StopSound(&tempSoundRingUp);
                isRingWarning = false;
            }
        }
    }
    else if (conZeroRingWarning == 2)
    {
        // Do nothing, i.e., let the sounds play
    }
}

Code "Unique Super Sonic 2 Aura" by "Batman Sonic & SuperNova124"
//Gives Super Sonic 2 a unique aura, thanks for the idea SuperNova :D

#include "Reflection" noemit

#import "GOComponents"
#import "PlayerVisuals"

#lib "GameManager"
#lib "GameObject"
#lib "Player"
#lib "BlackboardStatus"
#lib "Lua"
#lib "HMM"
#lib "INI"

#import "Graphics"
#import "Services"

// External DLLs
#load "WindowsBase.dll"
#load "PresentationCore.dll"
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;
using System.Windows.Media;
using System.IO;

static MediaPlayer sound = new MediaPlayer();
static float volumeLevel = 25.0f;
static bool initialized = false;
static bool soundPlayed = false;
static string currentModDirectory;
static bool isPaused = false; // Added variable to manage pause state
static int conSS2Aura = 0;
static string soundFileName = "";

if (!initialized)
{
    var mods = HMM.FindModsByName("Sound Overhaul Pack");

    if (mods.Count == 1)
    {
        currentModDirectory = mods[0].Path;
        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");

        if (File.Exists(modConfigIniPath))
        {
            var ini = INI.Read(modConfigIniPath);
		
        conSS2Aura = INI.Parse<int>(ini["Main"]["SS2Aura"], conSS2Aura);

        // Change the sound file based on conSS2Aura
        switch (conSS2Aura)
        {
            case 1:
                soundFileName = "SFX_SS2Aura.wav";
                break;
            case 2:
                // Disable sounds
                break;
            default:
                // Handle other cases if needed
                break;
        }

        volumeLevel = INI.Parse<float>(ini["Main"]["ss2Volume"], volumeLevel);
			
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] mod.ini not found.");
            return;
        }
    }
    else
    {
        Console.WriteLine("[Sound Overhaul Pack] Failed to locate mod directory.");
        return;
    }

    initialized = true;
}

// Check if the game is paused due to a movie playing
bool isMoviePlaying = false;
var pMovieManager = GameManager.GetService<MovieManager>();
if (pMovieManager != null)
{
    var pMoviePlayer = pMovieManager->GetCurrentMoviePlayer();
    if (pMoviePlayer != null)
    {
        isMoviePlaying = true;
    }
}

if (!isMoviePlaying)
{
    // SS2 Aura sound logic when not in a movie
    if (!BlackboardStatus.IsSuper())
    {
        // Logic for non-Super state...
    }
    // Rest of the existing SS2 Aura sound logic...
}
else
{
    // Pause or stop SS2 Aura sound when in a movie
    if (soundPlayed)
    {
        sound.Pause();
        soundPlayed = false;
    }
}

if (!BlackboardStatus.IsSuper())
{
}

if (Player.GetPlayerType() != Player.PlayerType.Sonic)
    return;

var data = Player.GetPlayerData();
if (data == null)
    return;

var gocVisual = GameObject.GetGOC<GOCPlayerVisual>(&data->GameObject);
if (gocVisual == null)
    return;

var visual = gocVisual->GetVisual<VisualSuperSonic>();
if (visual == null)
    return;
	
	if (conSS2Aura == 2)
    {
    // Disable sounds
   }
   else if (visual->IsSuperSonic2)
{
    if (Lua.GetState() != 0 && !soundPlayed)
    {
        string ss2SoundPath = Path.Combine(currentModDirectory, "raw_customSuper", soundFileName)));

        if (File.Exists(ss2SoundPath))
        {
            sound.Open(new Uri(ss2SoundPath));
            sound.Volume = volumeLevel / 100;
            sound.Position = new TimeSpan(0);
            sound.Play();
            soundPlayed = true;
        }
        else
        {
            Console.WriteLine("[Sound Overhaul Pack] Boost sound file not found.");
        }
    }

    if (isPaused && Lua.GetState() != 0)
    {
        sound.Play();
        isPaused = false;
    }
}
else
{
    if (soundPlayed && !visual->IsSuperSonic2)
    {
        sound.Stop();
        soundPlayed = false;
    }
}

// Handle pause state
if (Lua.GetState() == 0 && soundPlayed)
{
    if (!isPaused)
    {
        sound.Pause();
        isPaused = true;
    }
}

Code "Somersault when hitting wall terrian" by "Batman Sonic & SuperNova124"
//Plays a somersault sound when hitting terrian as Sonic or Knuckles.
#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"
	
#load "System.Numerics.dll"

using System.Numerics;

static bool SomersaultWall = false;

//
{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic && Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    if ((Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateWallLeave ||
         Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateWallLeave))
    {
        if (!SomersaultWall)
        {
            Player.Sound.PlaySound("sn_windmill_kick");
            Player.Sound.PlaySound("sa1001");
            SomersaultWall = true;
        }
    }
    else
    {
        SomersaultWall = false;
    }
}

Code "Grunt when wall slide" by "Batman Sonic & SuperNova124"
