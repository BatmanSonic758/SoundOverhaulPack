Code "Restore Quick Step" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

using System.Collections.Generic;
using System.IO;

static bool? configInitCache = null;
static int conQuickStep = 0;

static bool soundPlayed = false;

static List<Sonic.StateID> QuickStepStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateLeftStep,
    Sonic.StateID.StateLeftStepRun,
    Sonic.StateID.StateRightStep,
    Sonic.StateID.StateRightStepRun,
    Sonic.StateID.StateQuickStepLeft,
    Sonic.StateID.StateQuickStepRight,
    Sonic.StateID.StateQuickStepRoot
};

static List<Sonic.StateID> SuperSonicQuickStepStates = new List<Sonic.StateID>
{
    Sonic.StateID.StateAvoid,
    Sonic.StateID.StateAvoidLocal,
    Sonic.StateID.StateAvoidToTarget,
    Sonic.StateID.StateAvoidUpper
};

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");

        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");

            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conQuickStep = INI.Parse<int>(ini["Main"]["QuickStep"], 0);
            }
        }

        configInitCache = true;
    }

    if (conQuickStep == 3)
        return;

    var currentStateSonic = Player.State.GetCurrentStateID<Sonic.StateID>();
    var currentStateKnuckles = Player.State.GetCurrentStateID<Knuckles.StateID>();

    bool isQuickStep = QuickStepStates.Contains(currentStateSonic);
    bool isKnucklesQuickStep = currentStateKnuckles == Knuckles.StateID.KnucklesStateDrillBoostStep;
    bool isQuickStepSuper = BlackboardStatus.IsSuper() && SuperSonicQuickStepStates.Contains(currentStateSonic);

    bool anyQuickStepActive = isQuickStep || isKnucklesQuickStep || isQuickStepSuper;

    if (anyQuickStepActive && !soundPlayed)
    {
        switch (conQuickStep)
        {
            case 1:
                Player.Sound.PlaySound("sn_quickstep_swa");
                break;

            case 2:
                Player.Sound.PlaySound("sn_quickstep_anniversary");
                break;
        }

        soundPlayed = true;
    }

    if (!anyQuickStepActive)
    {
        soundPlayed = false;
    }
}

Code "Lost World-styled Spin Dash" by "Batman Sonic & SuperNova124"
