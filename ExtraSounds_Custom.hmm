static bool? configInitCache = null;
static int conSpinDashImpact = 0;

static List<Sonic.StateID> SpinDashStates = null;

static int poseHandle = 0;
static bool isPoseSound = false;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");
        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");
            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conSpinDashImpact = INI.Parse<int>(ini["Main"]["SpinDashImpact"], 0);
            }
        }

        SpinDashStates = new List<Sonic.StateID>
        {
            Sonic.StateID.StateQuickStepDoubleJump,
            Sonic.StateID.StateSpinBoost,
            Sonic.StateID.StateDriftDash,
            Sonic.StateID.StateDropDash,
            Sonic.StateID.StateSpin
        };

        configInitCache = true;
