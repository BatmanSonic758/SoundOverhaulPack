// UI

Code "Custom Homing Reticles" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

#import "States"

using System;
using System.IO;

static bool? configInitCache = null;
static int conHomingReticle = 0;

static bool soundPlayed = false;
static IntPtr lastLockOnTarget = IntPtr.Zero;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");

        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");

            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conHomingReticle = INI.Parse<int>(ini["Main"]["HomingReticle"], 0);
            }
        }

        configInitCache = true;
    }

    if (conHomingReticle == 9)
        return;

    var pGameObject = Player.Status.GetLockOnTarget();

    if (pGameObject == null)
    {
        soundPlayed = false;
        lastLockOnTarget = IntPtr.Zero;
        return;
    }

    var currentLockOnTarget = new IntPtr(pGameObject);

    if (soundPlayed &&
        currentLockOnTarget == lastLockOnTarget)
        return;

    switch (conHomingReticle)
    {
        case 1:
        default:
            Player.Sound.PlaySound("sn_lockon_rangers");
            break;

        case 2:
            Player.Sound.PlaySound("sn_lockon_wars_2");
            break;

        case 3:
            Player.Sound.PlaySound("sn_lockon_wars_1");
            break;

        case 4:
            Player.Sound.PlaySound("sn_lockon_anniversary");
            break;

        case 5:
            Player.Sound.PlaySound("sn_lockon_wildfire");
            break;

        case 6:
            Player.Sound.PlaySound("sn_lockon_sa1");
            break;

        case 7:
            Player.Sound.PlaySound("sn_lockon_next");
            break;

        case 8:
            Player.Sound.PlaySound("sn_lockon_miller");
            break;
    }

    soundPlayed = true;
    lastLockOnTarget = currentLockOnTarget;
}

Code "Restore Camera Gaze Sound" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "HMM"
#lib "INI"

using System.IO;

static bool? configInitCache = null;
static int conRestoreCameraGaze = 0;

static bool soundPlayed = false;
static bool cameraGazeWasEnabled = false;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");

        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");

            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);

                conRestoreCameraGaze = INI.Parse<int>(ini["Main"]["RestoreCameraGaze"], 0);
            }
        }

        configInitCache = true;
    }

    if (conRestoreCameraGaze != 1)
        return;

    bool isCameraGazePressed = Player.Input.IsPressed(Player.InputActionType.CameraGaze);

    bool isLockOnVisible = Player.Status.IsLockOnCursorVisible();

    // Lost lock-on
    if (!isLockOnVisible && cameraGazeWasEnabled)
        cameraGazeWasEnabled = false;

    if (!isCameraGazePressed)
    {
        soundPlayed = false;
        return;
    }

    bool canUseCameraGaze = isLockOnVisible && !IS_WORLD_FLAG(IsCyberSpace);

    if (canUseCameraGaze)
    {
        // Play only when enabling Camera Gaze
        if (!cameraGazeWasEnabled && !soundPlayed)
        {
            Player.Sound.PlaySound("sn_camera_gaze");
            soundPlayed = true;
        }

        cameraGazeWasEnabled = !cameraGazeWasEnabled;
    }
}

Code "Restore Boost Fail" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"

#import "Plugins"

static bool isBoostFailSound = false;

{
    var boost = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boost == null)
        return;

    bool isBoostFail = Player.Input.IsDown(Player.InputActionType.PlayerBoost) && boost->BoostAmount <= 0;

    if (isBoostFail && !isBoostFailSound)
    {
        Player.Sound.PlaySound("sn_boost_fail");
        isBoostFailSound = true;
    }

    if (Player.Input.IsReleased(Player.InputActionType.PlayerBoost))
        isBoostFailSound = false;
}

Code "Heat Knuckle Charge" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "GameObject"
#lib "Player"
#lib "Knuckles"
#lib "HMM"
#lib "INI"

using System.IO;

static bool? qolConfigCache = null;
static int conScrewdriverAbility = 0;

static int chargeHandle = 0;
static int auraHandle = 0;

static bool chargeSoundPlayed = false;

{
    if (qolConfigCache == null)
    {
        var qolMods = HMM.FindModsByName("Quality of Life Additions");
        if (qolMods.Count == 1)
        {
            string qolConfigIniPath = Path.Combine(qolMods[0].Path, "mod.ini");
            if (File.Exists(qolConfigIniPath))
            {
                var qolIni = INI.Read(qolConfigIniPath);
                conScrewdriverAbility = INI.Parse<int>(qolIni["Main"]["ScrewdriverAbility"], 0);
            }
        }
        qolConfigCache = true;
    }

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var pGameObject = Player.Status.GetLockOnTarget();
	
    if (pGameObject == null)
        return;

    bool hasHealthComponent = GameObject.GetGOC(pGameObject, "GOCHealth") != null;
    bool isAttackButtonDown = Player.Input.IsDown(Player.InputActionType.PlayerAttack);
    bool isAttackButtonReleased = Player.Input.IsReleased(Player.InputActionType.PlayerAttack);

    if (hasHealthComponent && isAttackButtonDown)
    {
        if (!chargeSoundPlayed)
        {
            // Lock-on sound always plays, no stop needed
            Player.Sound.PlaySound("kn_heat_knuckle_lockon");

            // Charge and aura only play if Screwdriver is disabled
            if (conScrewdriverAbility != 1)
            {
                chargeHandle = Player.Sound.PlaySound("kn_heat_knuckle_charge");
                auraHandle = Player.Sound.PlaySound("kn_heat_knuckle_aura");
            }

            // Mark as played even if Screwdriver is enabled (prevents re-triggering)
            chargeSoundPlayed = true;
        }
    }
    // Stop sounds when attack button released
    else if (chargeSoundPlayed && isAttackButtonReleased)
    {
        int localChargeHandle = chargeHandle;
        Player.Sound.StopSound(&localChargeHandle);

        int localAuraHandle = auraHandle;
        Player.Sound.StopSound(&localAuraHandle);

        chargeSoundPlayed = false;
    }
}

Code "Cyber Ghost Aura for Friends" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"

using System;
using System.IO;

static bool? configInitCache = null;
static int conCyberAuraFriends = 0;

static bool isIdleSound = false;
static int idleHandle = 0;
static Player.PlayerType lastPlayerType = Player.PlayerType.Sonic;
static IntPtr lastPlayer = IntPtr.Zero;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");
        if (mods.Count == 1)
        {
            string iniPath = Path.Combine(mods[0].Path, "mod.ini");
            if (File.Exists(iniPath))
            {
                var ini = INI.Read(iniPath);
                conCyberAuraFriends = INI.Parse<int>(ini["Main"]["CyberAuraFriends"], 0);
            }
        }
        configInitCache = true;
    }

    if (conCyberAuraFriends == 2)
        return;

    var data = Player.GetPlayerData();
	
    IntPtr player = data != null ? new IntPtr(data) : IntPtr.Zero;

    if (player != lastPlayer)
    {
        if (isIdleSound)
        {
            int dead = idleHandle;
            Player.Sound.StopSound(&dead);
        }
        isIdleSound = false;
        idleHandle = 0;
        lastPlayer = player;
    }

    if (player == IntPtr.Zero)
        return;

    var currentType = Player.GetPlayerType();

    if (currentType == Player.PlayerType.Sonic)
    {
        if (isIdleSound)
        {
            int stop = idleHandle;
            Player.Sound.StopSound(&stop);
            isIdleSound = false;
        }
        lastPlayerType = currentType;
        return;
    }

    if (isIdleSound && currentType == lastPlayerType)
        return;

    // Swapped straight from one friend to another
    if (isIdleSound)
    {
        int stop = idleHandle;
        Player.Sound.StopSound(&stop);
    }

    idleHandle = Player.Sound.PlaySound("obj_friends_idle");
    isIdleSound = true;
    lastPlayerType = currentType;
}

// Gameplay

Code "Restore Boost Jet" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Sonic"
#lib "HMM"
#lib "INI"

#load "System.Numerics.dll"

using System.Numerics;
using System.IO;

static bool? configInitCache = null;
static int conBoostJet = 0;
static int conSonicDriftBoost = 0;
static string boostJetSoundName = "sn_boost_jet_rangers";

static int boostJetHandle = 0;
static bool soundPlayed = false;

{
    if (configInitCache == null)
    {
        var mods = HMM.FindModsByName("Sound Overhaul Pack");
        if (mods.Count != 1)
        {
            configInitCache = false;
            return;
        }

        string modConfigIniPath = Path.Combine(mods[0].Path, "mod.ini");
        if (!File.Exists(modConfigIniPath))
        {
            configInitCache = false;
            return;
        }

        var ini = INI.Read(modConfigIniPath);
        conBoostJet = INI.Parse<int>(ini["Main"]["BoostJet"], 0);
        int conBoostJetSound = INI.Parse<int>(ini["Main"]["BoostJetSound"], 0);
        conSonicDriftBoost = INI.Parse<int>(ini["Main"]["SonicDriftBoost"], 0);

        boostJetSoundName = (conBoostJetSound == 1) ? "sn_boost_jet" : "sn_boost_jet_rangers";

        configInitCache = true;
    }

    if (configInitCache == false || conBoostJet == 4)
        return;

    // Disable for Super Sonic
    if (BlackboardStatus.IsSuper())
        return;

    bool isBoost = IS_STATE_FLAG(IsBoost);
    bool isPowerBoost = IS_WORLD_FLAG(IsPowerBoost);
    bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
    bool isDrifting = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift;

    if (!isBoost && !isDrifting && !soundPlayed)
        return;

    bool shouldPlay = false;

    if (isDrifting && conSonicDriftBoost == 1)
    {
        // Drift boost - check button held
        bool isBoostHeld = Player.Input.IsDown(Player.InputActionType.PlayerBoost);
        if (isBoostHeld)
        {
            switch (conBoostJet)
            {
                case 1: shouldPlay = true; break;
                case 2: shouldPlay = isPowerBoost || isCyberSpace; break;
                case 3: shouldPlay = isCyberSpace; break;
            }
        }
    }
    else if (!isDrifting && isBoost)
    {
        // Normal boost
        switch (conBoostJet)
        {
            case 1: shouldPlay = true; break;
            case 2: shouldPlay = isPowerBoost || isCyberSpace; break;
            case 3: shouldPlay = isCyberSpace; break;
        }
    }

    if (shouldPlay)
    {
        if (!soundPlayed)
        {
            boostJetHandle = Player.Sound.PlaySound(boostJetSoundName);
            soundPlayed = true;
        }
    }
    else
    {
        if (soundPlayed)
        {
            int stop = boostJetHandle;
            Player.Sound.StopSound(&stop);
            soundPlayed = false;
        }
    }
}

